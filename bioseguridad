  <a href="/"><i class="fas fa-house"></i><span>Inicio</span></a>
  <button data-section="protocolo" data-goto="protocolo"><i class="fas fa-shield-halved"></i><span>Protocolo</span></button>
  <button data-section="reservar" data-goto="reservar" class="nav-cta"><span class="disc"><i class="fas fa-calendar-plus"></i></span><span>Reservar</span></button>
  <button data-section="cuidados" data-goto="cuidados"><i class="fas fa-hand-holding-medical"></i><span>Cuidados</span></button>
  <button data-section="faq" data-goto="faq"><i class="fas fa-circle-question"></i><span>Dudas</span></button>
</nav>

<script>
(() => {
  "use strict";
  document.body.classList.remove("no-js");

  // Menú móvil / tablet (igual que la home)
  const header = document.getElementById("desktop-nav"), burger = document.getElementById("burger");
  const setMenu = (open) => {
    header.classList.toggle("menu-open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  burger.addEventListener("click", () => setMenu(!header.classList.contains("menu-open")));
  document.getElementById("nav-links").addEventListener("click", (e) => { if (e.target.closest("a")) setMenu(false); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });
  const WA = "573012802733";
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const FINE = matchMedia("(hover: hover) and (pointer: fine)").matches;
  const pad = (n, l = 2) => String(n).padStart(l, "0");
  const todayLocal = () => { const d = new Date(); return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`; };
  const waOpen = (msg) => window.open(`https://wa.me/${WA}?text=${encodeURIComponent(msg)}`, "_blank", "noopener");

  function showToast(msg, type) {
    const t = document.createElement("div");
    t.className = `toast ${type}`;
    t.innerHTML = `<i class="${type === "success" ? "fab fa-whatsapp" : "fas fa-circle-exclamation"}"></i><span></span>`;
    t.querySelector("span").textContent = msg;
    $("#toast-container").appendChild(t);
    setTimeout(() => { t.style.opacity = "0"; }, 3000);
    setTimeout(() => t.remove(), 3400);
  }

  function goTo(id) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: REDUCED ? "auto" : "smooth" });
  }
  document.addEventListener("click", (e) => {
    const t = e.target.closest("[data-goto]");
    if (!t) return;
    e.preventDefault();
    goTo(t.dataset.goto);
  });

  // Footer year
  $("#footer-copy").textContent = `© ${new Date().getFullYear()} Guerr Tattoo · Julián Guerrero · Suba, Bogotá`;

  // Open/closed in Bogotá time (Mon–Sat 10–19)
  function renderOpenState() {
    const el = $("#open-state");
    const now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Bogota" }));
    const day = now.getDay(), h = now.getHours();
    const open = day >= 1 && day <= 6 && h >= 10 && h < 19;
    el.className = `open-state ${open ? "open" : "closed"}`;
    el.innerHTML = `<i class="fas fa-circle"></i> ${open ? "Abierto ahora" : "Cerrado · abre a las 10am"}`;
  }
  renderOpenState();

  // Marquee
  const MARQ = ["Material estéril", "Un solo uso", "Tintas homologadas", "Espacio sanitizado", "Solo +18", "Bioseguridad Bogotá"];
  $("#marquee-a").innerHTML = MARQ.map((x) => `<span>${x}</span>`).join("").repeat(4);

  // Film grain
  function drawGrain() {
    const c = $("#grain"), size = 160;
    c.width = size; c.height = size;
    const ctx = c.getContext("2d"), img = ctx.createImageData(size, size);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = Math.random() * 255;
      img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
    c.style.backgroundImage = `url(${c.toDataURL()})`;
    c.width = 0; c.height = 0;
  }
  drawGrain();

  // Embers
  if (!REDUCED) {
    const box = $("#embers"), count = innerWidth < 768 ? 10 : 20;
    for (let i = 0; i < count; i++) {
      const p = document.createElement("div"), s = 1 + Math.random() * 2.5;
      p.className = "ember";
      p.style.cssText = `left:${Math.random() * 100}%;width:${s}px;height:${s}px;--drift:${(Math.random() - .5) * 120}px;animation-duration:${12 + Math.random() * 16}s;animation-delay:${Math.random() * 14}s`;
      box.appendChild(p);
    }
  }

  // Verificador de bioseguridad
  const boxes = $$("#check-items input");
  const fg = $("#score-fg"), CIRC = 2 * Math.PI * 52;
  fg.style.strokeDasharray = CIRC;
  function renderScore() {
    const n = boxes.filter((b) => b.checked).length, total = boxes.length;
    fg.style.strokeDashoffset = CIRC * (1 - n / total);
    fg.classList.toggle("ok", n === total);
    $("#score-num").textContent = `${n}/${total}`;
    const v = $("#score-verdict");
    if (n === 0) v.textContent = "Marca lo que ves en el estudio.";
    else if (n === total) v.innerHTML = "<b>Estudio seguro.</b> Cumple todo lo básico de bioseguridad.";
    else if (n >= 6) v.innerHTML = "<b>Casi.</b> Pregunta por lo que falta antes de tatuarte.";
    else v.innerHTML = "<b>Cuidado.</b> Faltan puntos clave: mejor busca otro lugar.";
  }
  boxes.forEach((b) => b.addEventListener("change", renderScore));
  $("#score-reset").addEventListener("click", () => { boxes.forEach((b) => { b.checked = false; }); renderScore(); });
  renderScore();

  // Scroll: active section, progress bar, hide-on-scroll nav
  const SECTIONS = ["hero", "pilares", "protocolo", "verifica", "antes", "cuidados", "reservar", "faq", "ubicacion"];
  const nav = $("#desktop-nav"), progress = $("#progress"), navItems = $$("[data-section]"), quote = $("#quote-float"), heroEl = $("#hero");
  let lastY = 0, ticking = false;
  function onScroll() {
    const y = scrollY;
    let current = SECTIONS[0];
    for (const id of SECTIONS) { const el = document.getElementById(id); if (el && y + 200 >= el.offsetTop) current = id; }
    navItems.forEach((el) => el.classList.toggle("active", el.dataset.section === current));
    nav.classList.toggle("scrolled", y > 20);
    nav.classList.toggle("hide", y > 600 && y > lastY + 4 && !nav.classList.contains("menu-open"));
    quote.classList.toggle("show", y > heroEl.offsetHeight * .6);
    if (y < lastY - 4) nav.classList.remove("hide");
    lastY = y;
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    ticking = false;
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  // Reveal on scroll
  $$(".stagger").forEach((g) => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .1, rootMargin: "0px 0px -40px 0px" });
    $$(".reveal, .stagger").forEach((el) => io.observe(el));
  } else {
    $$(".reveal, .stagger").forEach((el) => el.classList.add("in"));
  }

  // Count-up (numbers are already in the HTML for crawlers)
  if (!REDUCED) {
    $$("[data-count]").forEach((el) => {
      const end = parseFloat(el.dataset.count), t0 = performance.now(), dur = 1600;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / dur);
        el.textContent = Math.round(end * (1 - Math.pow(1 - p, 4)));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  // Mouse-only effects
  if (FINE && !REDUCED) {
    const ring = $("#cursor"), dot = $("#cursor-dot");
    let mx = 0, my = 0, rx = 0, ry = 0;
    addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px, ${my}px)`;
      ring.classList.add("on"); dot.classList.add("on");
    });
    document.addEventListener("mouseleave", () => { ring.classList.remove("on"); dot.classList.remove("on"); });
    const follow = () => { rx += (mx - rx) * .18; ry += (my - ry) * .18; ring.style.transform = `translate(${rx}px, ${ry}px)`; requestAnimationFrame(follow); };
    follow();
    document.addEventListener("mouseover", (e) => {
      ring.classList.toggle("hover", !!e.target.closest("a, button, label, summary, input, select, textarea"));
    });
    $$(".magnetic").forEach((b) => {
      b.addEventListener("mousemove", (e) => {
        const r = b.getBoundingClientRect();
        b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .25}px, ${(e.clientY - r.top - r.height / 2) * .35}px)`;
      });
      b.addEventListener("mouseleave", () => { b.style.transform = ""; });
    });
  }

  // Quick quote → WhatsApp
  const fecha = $("#fecha");
  fecha.min = todayLocal();
  $("#form-quick").addEventListener("submit", (e) => {
    e.preventDefault();
    const ubicacion = $("#ubicacion").value.trim();
    const idea = $("#idea").value.trim();
    const salud = $("#salud").value.trim();
    if (!ubicacion) { showToast("Indica la zona del cuerpo", "error"); $("#ubicacion").focus(); return; }
    if (idea.length < 10) { showToast("Cuéntame un poco más de tu idea", "error"); $("#idea").focus(); return; }
    if (!$("#mayor").checked) { showToast("Solo tatuamos a mayores de 18 años", "error"); $("#mayor").focus(); return; }
    if (fecha.value) {
      if (fecha.value < todayLocal()) { showToast("Escoge una fecha a partir de hoy", "error"); return; }
      const [y, m, d] = fecha.value.split("-").map(Number);
      if (new Date(y, m - 1, d).getDay() === 0) { showToast("Los domingos el estudio está cerrado", "error"); return; }
    }
    waOpen(`Hola Julián! Vengo de la página de Bioseguridad 🖤\n🎨 Estilo: ${$("#estilo").value}\n📏 Tamaño: ${$("#tamano").value}\n📍 Zona: ${ubicacion}\n📅 Fecha ideal: ${fecha.value || "flexible"}\n🩺 Salud/alergias: ${salud || "ninguna"}\n✅ Soy mayor de 18 años\n💭 Idea: ${idea}`);
    showToast("Abriendo WhatsApp con tu cotización...", "success");
  });
})();
</script>
