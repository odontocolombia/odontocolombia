  .deposit { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 16px 18px; margin: 4px 0 18px; border: 1px dashed rgba(224,27,34,.45); background: rgba(161,15,21,.07); }
  .deposit span { font-family: var(--sans); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone-dim); }
  .deposit span small { display: block; font-family: var(--serif); font-size: 14px; letter-spacing: 0; text-transform: none; font-style: italic; color: var(--ash); margin-top: 2px; }
  .deposit b { font-family: var(--sans); font-weight: 400; font-size: 24px; color: var(--bone); }
  .form-note { display: flex; align-items: center; gap: 8px; margin-top: 14px; font-size: 15px; font-style: italic; color: var(--ash); }
  .form-note i { color: var(--wa); font-style: normal; }
  .contact-list { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .contact-list li { display: flex; gap: 16px; align-items: center; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .contact-list i { flex-shrink: 0; width: 42px; height: 42px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); color: var(--blood-hot); font-size: 15px; }
  .contact-list b { display: block; font-family: var(--sans); font-weight: 400; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--bone-dim); }
  .contact-list span, .contact-list a { font-size: 19px; color: var(--bone); text-decoration: none; }
  .contact-list a:hover { color: var(--blood-hot); }
  .open-state { display: inline-flex; align-items: center; gap: 8px; margin-top: 4px; font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; }
  .open-state i { font-size: 7px; width: auto; height: auto; border: 0; }
  .open-state.open { color: var(--wa); }
  .open-state.closed { color: var(--ash); }

  /* ---------- FAQ ---------- */
  .faq-list { border-top: 1px solid var(--line); max-width: 900px; margin: 0 auto; }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 0; cursor: pointer; list-style: none; font-family: var(--serif); font-size: 22px; font-weight: 600; color: var(--bone); transition: color .2s; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:hover { color: var(--blood-hot); }
  .faq-list summary .pm { position: relative; flex-shrink: 0; width: 32px; height: 32px; border: 1px solid var(--line-strong); border-radius: 50%; }
  .faq-list summary .pm::before, .faq-list summary .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1px; margin: 0 0 0 -6px; background: var(--bone); transition: transform .4s var(--ease); }
  .faq-list summary .pm::after { transform: rotate(90deg); }
  .faq-list details[open] summary .pm { border-color: var(--blood-hot); background: var(--blood); }
  .faq-list details[open] summary .pm::after { transform: rotate(0); }
  .faq-list details p { padding: 0 48px 26px 0; font-size: 18px; font-style: italic; color: var(--bone-dim); line-height: 1.6; animation: rise .5s var(--ease) both; }

  /* ---------- Map ---------- */
  .location-grid { display: grid; gap: 18px; }
  @media (min-width: 1024px) { .location-grid { grid-template-columns: 1.5fr 1fr; gap: 24px; } }
  .map-wrap { position: relative; overflow: hidden; min-height: 340px; border: 1px solid var(--line); background: var(--ink-3); }
  @media (min-width: 1024px) { .map-wrap { min-height: 460px; } }
  .map-wrap iframe { position: absolute; inset: 0; width: 100%; height: calc(100% + 30px); border: 0; filter: grayscale(1) invert(1) contrast(1.25) brightness(.6) sepia(.35) hue-rotate(-20deg); }
  .map-wrap .attr-cover { position: absolute; bottom: 0; left: 0; right: 0; height: 30px; background: var(--ink-3); }
  .map-wrap .map-tint { position: absolute; inset: 0; pointer-events: none; background: radial-gradient(circle at 50% 50%, transparent 35%, rgba(7,6,6,.7)); }
  .map-pin { position: absolute; left: 50%; top: calc(50% + 15px); transform: translate(-50%, -100%); z-index: 2; pointer-events: none; display: flex; flex-direction: column; align-items: center; }
  .map-pin .lbl { padding: 8px 14px; background: var(--blood); font-family: var(--sans); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); white-space: nowrap; box-shadow: 0 10px 30px rgba(0,0,0,.6); }
  .map-pin .stem { width: 1px; height: 22px; background: var(--blood-hot); }
  .map-pin .dot { width: 10px; height: 10px; border-radius: 50%; background: var(--blood-hot); animation: pulseRed 2s infinite; margin-bottom: -5px; }

  /* ---------- Final CTA ---------- */
  .final-cta { position: relative; overflow: hidden; text-align: center; padding: 100px 20px; border-top: 1px solid var(--line); }
  @media (min-width: 1024px) { .final-cta { padding: 150px 48px; } }
  .final-cta::before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(161,15,21,.28), transparent 70%); pointer-events: none; }
  .final-cta h2 { position: relative; font-family: var(--gothic); font-weight: 400; font-size: clamp(3.2rem, 12vw, 7.4rem); line-height: .9; }
  .final-cta h2 em { font-style: normal; color: var(--blood-hot); }
  .final-cta p { position: relative; max-width: 32rem; margin: 22px auto 34px; font-size: 20px; font-style: italic; color: var(--bone-dim); }
  .final-cta .hero-btns { position: relative; justify-content: center; }

  /* ---------- Footer ---------- */
  footer { position: relative; z-index: 2; border-top: 1px solid var(--line); background: linear-gradient(180deg, transparent, rgba(161,15,21,.06)); padding: 64px 20px 130px; }
  @media (min-width: 1024px) { footer { padding: 90px 48px 40px; } }
  .footer-grid { display: grid; gap: 40px; }
  @media (min-width: 768px) { .footer-grid { grid-template-columns: 1.4fr 1fr 1fr; gap: 56px; } }
  .footer-brand .logo-link img { height: 54px; }
  .footer-brand .logo-link .wordmark b { font-size: 34px; }
  .footer-brand p { margin-top: 18px; font-size: 18px; font-style: italic; color: var(--bone-dim); max-width: 22rem; }
  .footer-col h2 { font-family: var(--sans); font-weight: 500; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: var(--blood-hot); margin-bottom: 18px; }
  .footer-col ul { list-style: none; display: grid; gap: 10px; }
  .footer-col li, .footer-col a { font-size: 18px; color: var(--bone-dim); text-decoration: none; transition: color .2s, padding .3s var(--ease); }
  .footer-col a:hover { color: var(--bone); padding-left: 6px; }
  .footer-col a[aria-current="page"] { color: var(--blood-hot); }
  .social-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px; }
  .social-links a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--bone-dim); border: 1px solid var(--line-strong); text-decoration: none; transition: all .25s; border-radius: 50%; }
  .social-links a:hover { color: var(--bone); background: var(--blood); border-color: var(--blood-hot); transform: translateY(-2px); }
  .footer-bottom { display: flex; flex-direction: column; gap: 10px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ash); }
  @media (min-width: 768px) { .footer-bottom { flex-direction: row; justify-content: space-between; } }
  .to-top { background: none; border: 0; cursor: pointer; font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--bone-dim); display: inline-flex; gap: 8px; align-items: center; }
  .to-top:hover { color: var(--blood-hot); }

  /* ---------- Toast ---------- */
  #toast-container { position: fixed; top: 20px; left: 16px; right: 16px; z-index: 9999; display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none; }
  @media (min-width: 1024px) { #toast-container { left: auto; right: 24px; top: 84px; align-items: flex-end; } }
  .toast { display: flex; align-items: center; gap: 12px; padding: 15px 20px; font-family: var(--sans); font-size: 13px; letter-spacing: .06em; pointer-events: auto; animation: rise .4s var(--ease) both; max-width: 360px; background: var(--ink-4); border: 1px solid var(--line-strong); border-left: 3px solid; box-shadow: 0 20px 40px rgba(0,0,0,.6); transition: opacity .3s; }
  .toast.success { border-left-color: var(--wa); color: var(--bone); }
  .toast.success i { color: var(--wa); }
  .toast.error { border-left-color: var(--blood-hot); color: #ff8a8d; }

  /* ---------- Reveal ---------- */
  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 1s var(--ease), transform 1s var(--ease); }
  .reveal.in { opacity: 1; transform: none; }
  .stagger > * { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease), transform .9s var(--ease); transition-delay: calc(var(--i, 0) * 80ms); }
  .stagger.in > * { opacity: 1; transform: none; }
  .no-js .reveal, .no-js .stagger > * { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .reveal, .stagger > * { opacity: 1; transform: none; }
  }

  /* ================= Bioseguridad: piezas propias ================= */
  /* Sello sanitario sobre la foto del hero */
  .seal { position: absolute; left: 22px; right: 22px; bottom: 22px; z-index: 2; padding: 18px 20px; background: rgba(7,6,6,.84); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line-strong); }
  .seal b { display: block; font-family: var(--sans); font-weight: 400; font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: var(--blood-hot); margin-bottom: 10px; }
  .seal ul { list-style: none; display: grid; gap: 7px; }
  .seal li { display: flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--bone); }
  .seal li i { color: var(--wa); font-size: 12px; }

  /* Checklist de la sesión (aside) */
  .tick-list { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .tick-list li { display: flex; gap: 12px; align-items: flex-start; padding: 12px 0; border-bottom: 1px solid var(--line); font-size: 17px; font-style: italic; color: var(--bone-dim); }
  .tick-list li i { color: var(--blood-hot); margin-top: 5px; font-size: 13px; font-style: normal; }

  /* Verificador interactivo: ¿es seguro tu estudio? */
  .checker { display: grid; gap: 22px; }
  @media (min-width: 1024px) { .checker { grid-template-columns: 1.3fr .7fr; gap: 28px; align-items: start; } }
  .check-items { display: grid; gap: 8px; }
  .check-item { display: grid; grid-template-columns: 34px 1fr; gap: 16px; align-items: center; padding: 18px 20px; border: 1px solid var(--line); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); cursor: pointer; transition: border-color .3s, background .3s, transform .4s var(--ease); }
  .check-item:hover { border-color: rgba(224,27,34,.45); transform: translateX(4px); }
  .check-item input { position: absolute; opacity: 0; pointer-events: none; }
  .check-item .box { width: 34px; height: 34px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); color: transparent; font-size: 14px; transition: all .25s; }
  .check-item input:checked + .box { background: var(--blood); border-color: var(--blood-hot); color: var(--bone); box-shadow: 0 0 18px var(--blood-glow); }
  .check-item input:focus-visible + .box { outline: 1px solid var(--blood-hot); outline-offset: 3px; }
  .check-item b { display: block; font-family: var(--sans); font-weight: 400; font-size: 13px; letter-spacing: .2em; text-transform: uppercase; color: var(--bone); }
  .check-item span { display: block; font-size: 16px; font-style: italic; color: var(--ash); margin-top: 3px; }
  .check-item:has(input:checked) { border-color: rgba(224,27,34,.5); background: linear-gradient(90deg, rgba(161,15,21,.14), var(--ink-2)); }
  .score-card { position: sticky; top: 90px; text-align: center; }
  .score-ring { position: relative; width: 170px; height: 170px; margin: 6px auto 4px; }
  .score-ring svg { width: 100%; height: 100%; transform: rotate(-90deg); }
  .score-ring circle { fill: none; stroke-width: 6; }
  .score-ring .bg { stroke: var(--line-strong); }
  .score-ring .fg { stroke: var(--blood-hot); stroke-linecap: round; transition: stroke-dashoffset .8s var(--ease), stroke .4s; filter: drop-shadow(0 0 8px var(--blood-glow)); }
  .score-ring .fg.ok { stroke: var(--wa); filter: drop-shadow(0 0 8px rgba(37,211,102,.4)); }
  .score-num { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center; font-family: var(--sans); font-weight: 300; font-size: 44px; line-height: 1; color: var(--bone); }
  .score-num small { font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: var(--ash); margin-top: 6px; }
  .score-verdict { font-family: var(--serif); font-size: 19px; font-style: italic; color: var(--bone-dim); min-height: 3em; }
  .score-verdict b { font-style: normal; color: var(--bone); }

  /* Cuidados: línea de tiempo */
  .care-grid { display: grid; gap: 12px; }
  @media (min-width: 900px) { .care-grid { grid-template-columns: repeat(3, 1fr); gap: 14px; } }
  .care { position: relative; padding: 34px 26px 30px; border: 1px solid var(--line); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); transition: transform .5s var(--ease), border-color .4s; }
  .care:hover { transform: translateY(-6px); border-color: rgba(224,27,34,.5); }
  .care .days { font-family: var(--sans); font-weight: 300; font-size: 40px; line-height: 1; color: transparent; -webkit-text-stroke: 1px var(--blood-hot); }
  .care h3 { font-family: var(--sans); font-weight: 400; font-size: 14px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); margin: 16px 0 12px; }
  .care ul { list-style: none; display: grid; gap: 8px; }
  .care li { display: flex; gap: 10px; font-size: 17px; font-style: italic; color: var(--bone-dim); line-height: 1.45; }
  .care li i { color: var(--blood-hot); font-size: 11px; margin-top: 7px; font-style: normal; }
  .alert-note { display: flex; gap: 14px; align-items: flex-start; margin-top: 22px; padding: 18px 20px; border: 1px dashed rgba(224,27,34,.45); background: rgba(161,15,21,.07); font-size: 17px; font-style: italic; color: var(--bone-dim); }
  .alert-note i { color: var(--blood-hot); font-size: 18px; margin-top: 3px; font-style: normal; }
  .alert-note b { color: var(--bone); font-style: normal; }

  /* Antes de tu cita: sí / no */
  .dodont { display: grid; gap: 12px; }
  @media (min-width: 768px) { .dodont { grid-template-columns: 1fr 1fr; gap: 14px; } }
  .dd { padding: 32px 26px; border: 1px solid var(--line); background: var(--ink-2); }
  .dd h3 { display: flex; align-items: center; gap: 12px; font-family: var(--gothic); font-weight: 400; font-size: 34px; line-height: 1; margin-bottom: 18px; }
  .dd.yes h3 i { color: var(--wa); font-size: 20px; }
  .dd.no h3 i { color: var(--blood-hot); font-size: 20px; }
  .dd.yes { border-top: 2px solid var(--wa); }
  .dd.no { border-top: 2px solid var(--blood-hot); }

  /* Casilla de mayoría de edad en el formulario */
  .agree { display: flex; gap: 12px; align-items: flex-start; margin: 2px 0 18px; font-size: 16px; font-style: italic; color: var(--bone-dim); cursor: pointer; }
  .agree input { width: 18px; height: 18px; margin-top: 3px; accent-color: var(--blood-hot); flex-shrink: 0; cursor: pointer; }
  /* ---------- SEO/GEO audit additions ---------- */
  .sec-kw { display: block; font-family: var(--sans); font-weight: 300; font-size: clamp(.8rem, 2.4vw, .95rem); letter-spacing: .26em; text-transform: uppercase; line-height: 1.5; color: var(--bone-dim); margin-top: 12px; }
  .footer-col .footer-h { font-family: var(--sans); font-weight: 500; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: var(--blood-hot); margin-bottom: 18px; }
  @media (min-width: 1024px) { .footer-grid.four { grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 48px; } }
  .footer-legal { display: flex; flex-wrap: wrap; gap: 8px 20px; }
  .footer-legal a { color: var(--bone-dim); text-decoration: none; }
  .footer-legal a:hover { color: var(--blood-hot); }
  .zones { margin-top: 28px; padding: 28px 24px; border: 1px solid var(--line); background: var(--ink-2); }
  .zones h3 { font-family: var(--sans); font-weight: 400; font-size: 14px; letter-spacing: .2em; text-transform: uppercase; color: var(--bone); margin-bottom: 16px; }
  .zones ul { list-style: none; display: flex; flex-wrap: wrap; gap: 10px; }
  .zones li { padding: 9px 16px; border: 1px solid var(--line-strong); border-radius: 999px; font-family: var(--sans); font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--bone-dim); }
  .zones li i { color: var(--blood-hot); margin-right: 8px; }
  .zones p { margin-top: 16px; font-size: 17px; font-style: italic; color: var(--bone-dim); }
  .styles-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 28px; }
  .styles-links a { padding: 10px 18px; border: 1px solid var(--line-strong); border-radius: 999px; font-family: var(--sans); font-size: 12px; letter-spacing: .16em; text-transform: uppercase; color: var(--bone-dim); text-decoration: none; transition: all .25s; }
  .styles-links a:hover { color: var(--bone); border-color: var(--blood-hot); background: rgba(161,15,21,.18); }
  .styles-intro { margin-top: 48px; font-size: 18px; font-style: italic; color: var(--bone-dim); }

  /* =====================================================================
     ESTILO UNIFICADO CON LA PÁGINA PRINCIPAL (web + móvil)
     Mismos títulos góticos con degradado, textos Roboto, etiquetas Oswald
     y botones tipo píldora brillante que la home.
     ===================================================================== */
  :root {
    --t-label: max(12px, calc(13 * var(--u)));
    --t-small: clamp(14px, 0.84rem + 0.12vw, 15.5px);
    --t-body: max(16px, min(18.5px, calc(0.94rem + 0.22vw)));
    --t-lead: clamp(17.5px, 1rem + 0.35vw, 21px);
    --t-btn: max(14px, calc(15 * var(--u)));
    --track-label: .12em;
  }
  body { font-family: var(--ref-sans); color: var(--ref-white); font-size: var(--t-body); line-height: 1.6; text-rendering: optimizeLegibility; }
  h1, h2, h3, .sec-title, .final-cta h2, .fc-head h3, .route-card h3, .dd h3 { text-wrap: balance; }
  p, li, summary { text-wrap: pretty; }
  section, .final-cta { scroll-margin-top: calc(var(--header-h) + 8px); }
  @media (min-width: 1024px) { section { scroll-margin-top: calc(var(--header-h) + 8px); } }

  /* ---------- Hero ---------- */
  #hero { padding-top: 28px; }
  @media (min-width: 1024px) { #hero { min-height: calc(100vh - var(--header-h)); padding-top: 64px; padding-bottom: 96px; } }
  @media (min-width: 1200px) { #hero { margin-top: calc(-1 * var(--header-h)); min-height: 100vh; padding-top: calc(var(--header-h) + 56px); } }
  .crumbs { gap: 12px; margin-bottom: 0; font-family: var(--sans); font-size: var(--t-label); font-weight: 400; letter-spacing: .1em; color: var(--ref-white); }
  .crumbs::before { content: ""; width: max(24px, calc(46 * var(--u))); height: 2px; background: var(--blood-hot); box-shadow: 0 0 8px rgba(217,0,22,.7); }
  .crumbs a { color: var(--ref-grey); }
  .crumbs a:hover { color: var(--blood-hot); }
  .avail { margin-top: 18px; gap: 10px; padding: 9px 18px; border: 1px solid rgba(255,255,255,.22); border-radius: var(--radius-pill); background: rgba(10,10,10,.62); font-family: var(--sans); font-size: var(--t-label); letter-spacing: .1em; color: var(--ref-white); }
  .avail .dot { width: 9px; height: 9px; background: var(--blood-hot); box-shadow: 0 0 10px var(--blood-hot); }
  .avail b { font-weight: 500; color: var(--ref-white); }
  /* El texto fluye como una sola línea que puede partirse, sin columnas */
  .avail { display: inline-block; line-height: 1.5; border-radius: 22px; }
  .avail .dot { display: inline-block; margin-right: 8px; vertical-align: 1px; }

  /* Título gótico: línea plateada, línea carmesí grande y línea blanca pequeña */
  .hero-copy > .hero-title { animation: none; }
  .hero-title { font-family: var(--gothic); font-weight: 400; font-size: clamp(3.2rem, 12vw, 6.6rem); line-height: 1.02; color: var(--ref-white); margin: 20px 0 22px; text-shadow: none; }
  .hero-title .hero-kicker { display: block; font-family: var(--sans); font-weight: 400; font-size: var(--t-label); letter-spacing: .12em; text-transform: uppercase; line-height: 1.6; color: var(--ref-grey); margin-bottom: 14px; }
  .hero-title .ln { display: block; white-space: nowrap; line-height: 1.02; }
  .hero-title .ln + .ln { margin-top: .04em; }
  .hero-title .ln > span { display: inline-block; padding: .14em .08em .1em; margin: -.14em -.08em -.1em; animation: inkIn 1.3s var(--ease) both .15s; filter: drop-shadow(0 8px 24px rgba(0,0,0,.9)); }
  .hero-title .ln:nth-child(3) > span { animation-delay: .3s; }
  .hero-title .ln:nth-child(4) > span { animation-delay: .45s; }
