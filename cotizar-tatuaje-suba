  .faq-list summary .pm::before, .faq-list summary .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1px; margin: 0 0 0 -6px; background: var(--bone); transition: transform .4s var(--ease); }
