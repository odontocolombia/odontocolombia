<script>
(() => {
  "use strict";
  const WA = "573012802733";
  const EMAIL = "guerrtattoostudio@gmail.com";
  const $ = (s, r = document) => r.querySelector(s);
  const $$ = (s, r = document) => [...r.querySelectorAll(s)];
  const REDUCED = matchMedia("(prefers-reduced-motion: reduce)").matches;
  const FINE = matchMedia("(hover: hover) and (pointer: fine)").matches;

  // Price tiers (COP). Same ranges as the structured data in <head>.
  const TIERS = [
    { id: "mini",    name: "Mini / Flash", size: "3-5 cm",    min: 180000,  max: 300000,  plus: false, hours: "30 min - 1 h" },
    { id: "pequeno", name: "Pequeño",      size: "5-10 cm",   min: 300000,  max: 530000,  plus: false, hours: "1 - 2 h", hot: true },
    { id: "mediano", name: "Mediano",      size: "10-15 cm",  min: 530000,  max: 950000,  plus: false, hours: "2 - 4 h" },
    { id: "grande",  name: "Grande",       size: "15-25 cm",  min: 950000,  max: 1800000, plus: true,  hours: "4 - 6 h" },
    { id: "fullday", name: "Full Day",     size: "6-8 horas", min: 1200000, max: 2400000, plus: true,  hours: "Día completo" },
  ];
  // Modest adjustments so the estimate stays close to the published ranges
  const STYLES = [
    { id: "fine",   label: "Fine line",          k: 1 },
    { id: "black",  label: "Blackwork",          k: 1 },
    { id: "real",   label: "Realismo / sombras", k: 1.12 },
    { id: "orient", label: "Oriental",           k: 1.08 },
    { id: "neo",    label: "Neotradicional",     k: 1.05 },
    { id: "letter", label: "Lettering",          k: 0.95 },
    { id: "cover",  label: "Cover-up",           k: 1.15 },
  ];
  const COLORS = [
    { id: "bn",    label: "Negro y gris", k: 1 },
    { id: "color", label: "A color",      k: 1.1 },
  ];
  const ZONES = [
    { id: "brazo",    label: "Brazo / antebrazo",   k: 1 },
    { id: "pierna",   label: "Pierna",              k: 1 },
    { id: "espalda",  label: "Espalda / pecho",     k: 1.05 },
    { id: "costilla", label: "Costillas",           k: 1.12 },
    { id: "cuello",   label: "Cuello / mano / pie", k: 1.12 },
  ];
  const ROMAN = ["I", "II", "III", "IV", "V"];

  const money = (n) => "$" + n.toLocaleString("es-CO");
  const short = (n) => n >= 1000000 ? `${(n / 1000000).toLocaleString("es-CO")}M` : `${n / 1000}k`;
  const round10k = (n) => Math.round(n / 10000) * 10000;
  const byId = (list, id) => list.find((x) => x.id === id);

  function showToast(msg, type) {
    const t = document.createElement("div");
    t.className = `toast ${type}`;
    t.innerHTML = `<i class="${type === "success" ? "fab fa-whatsapp" : "fas fa-circle-exclamation"}"></i><span></span>`;
    t.querySelector("span").textContent = msg;
    $("#toast-container").appendChild(t);
    setTimeout(() => { t.style.opacity = "0"; }, 3000);
    setTimeout(() => t.remove(), 3400);
  }
  function goTo(id) {
    const el = document.getElementById(id);
    if (el) el.scrollIntoView({ behavior: REDUCED ? "auto" : "smooth" });
  }
  document.addEventListener("click", (e) => {
    const t = e.target.closest("[data-goto]");
    if (!t) return;
    e.preventDefault();
    goTo(t.dataset.goto);
  });

  // ---------- Price cards ----------
  $("#tiers").innerHTML = TIERS.map((t, i) => {
    const k = short(t.min);
    return `
    <article class="price-card${t.hot ? " featured" : ""}" data-tier="${t.id}" tabindex="0" aria-label="Calcular ${t.name}">
      ${t.hot ? '<span class="pc-ribbon">Más pedido</span>' : ""}
      <span class="corner tl"></span><span class="corner tr"></span><span class="corner bl"></span><span class="corner br"></span>
      <p class="pc-idx">${ROMAN[i]}</p>
      <h3 class="pc-name">${t.name}</h3>
      <div class="pc-price"><span class="pc-from">Desde</span><sup>$</sup>${k.slice(0, -1)}<em>${k.slice(-1)}</em></div>
      <ul class="pc-meta"><li class="top">hasta ${money(t.max)}${t.plus ? "+" : ""}</li><li>${t.size}</li><li>${t.hours}</li></ul>
      <span class="btn ${t.hot ? "btn-blood" : "btn-ghost"} btn-sm btn-block pc-cta">Calcular</span>
    </article>`;
  }).join("");

  // ---------- Calculator chips ----------
  const chips = (el, name, items, labelFn, checkedId) => {
    $(el).innerHTML = items.map((it) => `
      <label class="chip"><input type="radio" name="${name}" value="${it.id}" ${it.id === checkedId ? "checked" : ""} /><span>${labelFn(it)}</span></label>`).join("");
  };
  chips("#c-size", "size", TIERS, (t) => `${t.name}<small>${t.size}</small>`, "pequeno");
  chips("#c-style", "style", STYLES, (s) => s.label, "fine");
  chips("#c-color", "color", COLORS, (c) => c.label, "bn");
  chips("#c-zone", "zone", ZONES, (z) => z.label, "brazo");

  const val = (name) => $(`input[name="${name}"]:checked`).value;
  const estimate = () => {
    const s = { tier: byId(TIERS, val("size")), style: byId(STYLES, val("style")), color: byId(COLORS, val("color")), zone: byId(ZONES, val("zone")) };
    const k = s.style.k * s.color.k * s.zone.k;
    return { ...s, min: round10k(s.tier.min * k), max: round10k(s.tier.max * k) };
  };
  const rangeText = (e) => `${money(e.min)} – ${money(e.max)}${e.tier.plus ? "+" : ""}`;

  function renderEstimate() {
    const e = estimate();
    const el = $("#est-val");
    el.innerHTML = `${rangeText(e)}<small>COP</small>`;
    el.classList.remove("pop"); void el.offsetWidth; el.classList.add("pop");
    $("#est-det").textContent = `${e.tier.name} (${e.tier.size}) · ${e.style.label} · ${e.color.label} · ${e.zone.label}. Tiempo aprox.: ${e.tier.hours}.`;
    updateMail();
  }
  $$("#calculadora input[type=radio]").forEach((r) => r.addEventListener("change", renderEstimate));

  // Clicking a price card preselects its size in the calculator
  const pickTier = (card) => {
    $(`input[name="size"][value="${card.dataset.tier}"]`).checked = true;
    renderEstimate();
    goTo("calculadora");
  };
  $("#tiers").addEventListener("click", (e) => { const c = e.target.closest("[data-tier]"); if (c) pickTier(c); });
  $("#tiers").addEventListener("keydown", (e) => {
    const c = e.target.closest("[data-tier]");
    if (c && (e.key === "Enter" || e.key === " ")) { e.preventDefault(); pickTier(c); }
  });

  // ---------- Quote form ----------
  const buildMessage = () => {
    const e = estimate();
    return [
      `Hola Julián, soy ${$("#q-name").value.trim() || "—"}. Quiero cotizar un tatuaje.`,
      ``,
      `Idea: ${$("#q-idea").value.trim() || "—"}`,
      `Tamaño: ${e.tier.name} (${e.tier.size})`,
      `Estilo: ${e.style.label}`,
      `Color: ${e.color.label}`,
      `Zona: ${e.zone.label}`,
      `Cuándo: ${$("#q-when").value}`,
      `Estimado de la web: ${rangeText(e)} COP`,
      ``,
      `(Enviado desde guerrtattoostudio.com/cotizar-tatuaje-suba)`,
    ].join("\n");
  };
  function updateMail() {
    const subject = encodeURIComponent("Cotización de tatuaje - Suba");
    $("#mail-link").href = `mailto:${EMAIL}?subject=${subject}&body=${encodeURIComponent(buildMessage())}`;
  }
  const idea = $("#q-idea");
  idea.addEventListener("input", () => { $("#char-count").textContent = `${idea.value.length} / 500`; });
  ["#q-name", "#q-idea", "#q-when"].forEach((s) => $(s).addEventListener("input", updateMail));

  $("#quote-form").addEventListener("submit", (e) => {
    e.preventDefault();
    if ($("#q-name").value.trim().length < 2) { showToast("Escribe tu nombre", "error"); $("#q-name").focus(); return; }
    if (idea.value.trim().length < 10) { showToast("Cuéntame un poco más de tu idea", "error"); idea.focus(); return; }
    window.open(`https://wa.me/${WA}?text=${encodeURIComponent(buildMessage())}`, "_blank", "noopener");
    showToast("Abriendo WhatsApp con tu cotización...", "success");
  });

  // ---------- Small dynamic bits ----------
  $("#footer-copy").textContent = `© ${new Date().getFullYear()} Guerr Tattoo · Julián Guerrero · Suba, Bogotá`;
  function renderOpenState() {
    const el = $("#open-state");
    const now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Bogota" }));
    const day = now.getDay(), h = now.getHours();
    const open = day >= 1 && day <= 6 && h >= 10 && h < 19;
    el.className = `open-state ${open ? "open" : "closed"}`;
    el.innerHTML = `<i class="fas fa-circle"></i> ${open ? "Abierto ahora" : "Cerrado · abre a las 10am"}`;
  }
  renderOpenState();

  const LIST_A = ["Mini desde $180k", "Pequeño desde $300k", "Mediano desde $530k", "Grande desde $950k", "Full Day desde $1.2M"];
  const LIST_B = ["Diseño incluido", "Bioseguridad certificada", "Depósito $40.000", "Efectivo · Transferencia · Tarjeta", "Suba · Bogotá"];
  const fillMarquee = (id, list) => { $(id).innerHTML = list.map((x) => `<span>${x}</span>`).join("").repeat(4); };
  fillMarquee("#marquee-a", LIST_A);
  fillMarquee("#marquee-b", LIST_B);

  function countUp() {
    $$("[data-count]").forEach((el) => {
      const end = parseFloat(el.dataset.count);
      if (REDUCED) { el.textContent = end; return; }
      const t0 = performance.now(), dur = 1600;
      const step = (now) => {
        const p = Math.min(1, (now - t0) / dur), eased = 1 - Math.pow(1 - p, 4);
        el.textContent = Math.round(end * eased);
        if (p < 1) requestAnimationFrame(step);
      };
      setTimeout(() => requestAnimationFrame(step), 500);
    });
  }

  // Film grain texture, generated once and tiled
  function drawGrain() {
    const c = $("#grain"), size = 160;
    c.width = size; c.height = size;
    const ctx = c.getContext("2d"), img = ctx.createImageData(size, size);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = Math.random() * 255;
      img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
    c.style.backgroundImage = `url(${c.toDataURL()})`;
    c.width = 0; c.height = 0;
  }
  drawGrain();

  // Rising embers (fewer on small screens)
  if (!REDUCED) {
    const box = $("#embers"), count = innerWidth < 768 ? 12 : 24;
    for (let i = 0; i < count; i++) {
      const p = document.createElement("div"), s = 1 + Math.random() * 2.5;
      p.className = "ember";
      p.style.cssText = `left:${Math.random() * 100}%;width:${s}px;height:${s}px;--drift:${(Math.random() - .5) * 120}px;animation-duration:${12 + Math.random() * 16}s;animation-delay:${Math.random() * 14}s`;
      box.appendChild(p);
    }
  }


  // Menú móvil / tablet (igual que la home)
  const header = document.getElementById("desktop-nav"), burger = document.getElementById("burger");
  const setMenu = (open) => {
    header.classList.toggle("menu-open", open);
    burger.setAttribute("aria-expanded", String(open));
    burger.setAttribute("aria-label", open ? "Cerrar menú" : "Abrir menú");
  };
  burger.addEventListener("click", () => setMenu(!header.classList.contains("menu-open")));
  document.getElementById("nav-links").addEventListener("click", (e) => { if (e.target.closest("a")) setMenu(false); });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") setMenu(false); });

  // ---------- Scroll: active section, progress, hide-on-scroll nav ----------
  const SECTIONS = ["hero", "precios", "factores", "calculadora", "proceso", "incluye", "preguntas", "ubicacion"];
  const nav = $("#desktop-nav"), progress = $("#progress"), navItems = $$("[data-section]"), quote = $("#quote-float"), heroEl = $("#hero"), calcEl = $("#calculadora");
  let lastY = 0, ticking = false;
  function onScroll() {
    const y = scrollY;
    let current = SECTIONS[0];
    for (const id of SECTIONS) {
      const el = document.getElementById(id);
      if (el && y + 200 >= el.offsetTop) current = id;
    }
    navItems.forEach((el) => el.classList.toggle("active", el.dataset.section === current));
    nav.classList.toggle("scrolled", y > 20);
    nav.classList.toggle("hide", y > 600 && y > lastY + 4 && !nav.classList.contains("menu-open"));
    // Se oculta mientras la calculadora está en pantalla
    const inCalc = y + innerHeight > calcEl.offsetTop && y < calcEl.offsetTop + calcEl.offsetHeight;
    quote.classList.toggle("show", y > heroEl.offsetHeight * .6 && !inCalc);
    if (y < lastY - 4) nav.classList.remove("hide");
    lastY = y;
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    ticking = false;
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  // ---------- Reveal on scroll ----------
  $$(".stagger").forEach((g) => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .1, rootMargin: "0px 0px -40px 0px" });
    $$(".reveal, .stagger").forEach((el) => io.observe(el));
  } else {
    $$(".reveal, .stagger").forEach((el) => el.classList.add("in"));
  }

  // ---------- Mouse-only effects: cursor, magnetic buttons, hero tilt ----------
  if (FINE && !REDUCED) {
    const ring = $("#cursor"), dot = $("#cursor-dot");
    let mx = 0, my = 0, rx = 0, ry = 0;
    addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px, ${my}px)`;
      ring.classList.add("on"); dot.classList.add("on");
    });
    document.addEventListener("mouseleave", () => { ring.classList.remove("on"); dot.classList.remove("on"); });
    const follow = () => {
      rx += (mx - rx) * .18; ry += (my - ry) * .18;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      requestAnimationFrame(follow);
    };
    follow();
    document.addEventListener("mouseover", (e) => {
      ring.classList.toggle("hover", !!e.target.closest("a, button, label, .price-card, summary, input, select, textarea"));
    });
    $$(".magnetic").forEach((b) => {
      b.addEventListener("mousemove", (e) => {
        const r = b.getBoundingClientRect();
        const x = (e.clientX - r.left - r.width / 2) * .25, y = (e.clientY - r.top - r.height / 2) * .35;
        b.style.transform = `translate(${x}px, ${y}px)`;
      });
      b.addEventListener("mouseleave", () => { b.style.transform = ""; });
    });
    const hv = $("#hero-visual");
    hv.addEventListener("mousemove", (e) => {
      const r = hv.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      hv.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    hv.addEventListener("mouseleave", () => { hv.style.transform = ""; });
  }

  renderEstimate();
  countUp();
})();
</script>
