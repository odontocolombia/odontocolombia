  /* ---------- Estilos más pedidos (enlaces destacados) ---------- */
  .top-styles { display: grid; gap: 14px; margin-bottom: 40px; }
  @media (min-width: 768px) { .top-styles { grid-template-columns: 1fr 1fr; gap: 18px; } }
