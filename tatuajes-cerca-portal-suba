  .arch { position: relative; width: 100%; aspect-ratio: 3 / 4; border-radius: 999px 999px 0 0; overflow: hidden; border: 1px solid var(--line-strong); background: var(--ink-3); animation: archOpen 1.6s var(--ease-io) both .3s; }
  .arch::after { content: ""; position: absolute; inset: 10px; border-radius: 999px 999px 0 0; border: 1px solid rgba(236,227,210,.22); pointer-events: none; }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: center 40%; filter: contrast(1.08) brightness(.8); transition: transform 1.2s var(--ease), filter .8s; }
