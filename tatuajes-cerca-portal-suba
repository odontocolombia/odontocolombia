  .marquee-track span::after { content: "\2020"; font-family: var(--serif); font-size: 22px; color: var(--ink); }

  /* ---------- Section heads ---------- */
  .sec-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 44px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
