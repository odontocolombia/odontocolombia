  @media (min-width: 1024px) { .why { border: 1px solid var(--line); border-right: 0; padding: 44px 30px 40px; } .why:last-child { border-right: 1px solid var(--line); } .why:nth-child(odd) { padding-left: 30px; } }
  .why::before { content: ""; position: absolute; left: 0; top: -1px; height: 2px; width: 0; background: var(--blood-hot); box-shadow: 0 0 12px var(--blood-glow); transition: width .6s var(--ease); }
