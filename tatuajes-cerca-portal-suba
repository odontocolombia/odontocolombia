  /* ---------- Lightbox ---------- */
  #lightbox { display: none; position: fixed; inset: 0; z-index: 9000; flex-direction: column; align-items: center; justify-content: center; gap: 18px; background: rgba(4,3,3,.97); backdrop-filter: blur(10px); animation: fadeIn .25s ease; padding: 70px 16px 30px; }
