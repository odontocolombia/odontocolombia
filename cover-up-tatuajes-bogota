    const t = document.createElement("div");
    t.className = `toast ${type}`;
    t.innerHTML = `<i class="${type === "success" ? "fab fa-whatsapp" : "fas fa-circle-exclamation"}"></i><span></span>`;
    t.querySelector("span").textContent = msg;
    $("#toast-container").appendChild(t);
    setTimeout(() => { t.style.opacity = "0"; }, 3000);
    setTimeout(() => t.remove(), 3400);
  }

  document.addEventListener("click", (e) => {
    const t = e.target.closest("[data-goto]");
    if (!t) return;
    e.preventDefault();
    const el = document.getElementById(t.dataset.goto);
    if (el) el.scrollIntoView({ behavior: REDUCED ? "auto" : "smooth" });
  });

  // Open/closed in Bogotá time (Mon–Sat 10–19)
  function renderOpenState() {
    const el = $("#open-state");
    const now = new Date(new Date().toLocaleString("en-US", { timeZone: "America/Bogota" }));
    const day = now.getDay(), h = now.getHours();
    const open = day >= 1 && day <= 6 && h >= 10 && h < 19;
    el.className = `open-state ${open ? "open" : "closed"}`;
    el.innerHTML = `<i class="fas fa-circle"></i> ${open ? "Abierto ahora" : "Cerrado · abre a las 10am"}`;
  }
  renderOpenState();

  const MARQUEE = ["Cover Up Bogotá", "Tapar Tatuajes", "Nombres", "Tribales", "Rework", "Segunda Oportunidad", "Suba · Bogotá"];
  $("#marquee-a").innerHTML = MARQUEE.map((x) => `<span>${x}</span>`).join("").repeat(4);

  // Film grain
  function drawGrain() {
    const c = $("#grain"), size = 160;
    c.width = size; c.height = size;
    const ctx = c.getContext("2d"), img = ctx.createImageData(size, size);
    for (let i = 0; i < img.data.length; i += 4) {
      const v = Math.random() * 255;
      img.data[i] = img.data[i + 1] = img.data[i + 2] = v; img.data[i + 3] = 255;
    }
    ctx.putImageData(img, 0, 0);
    c.style.backgroundImage = `url(${c.toDataURL()})`;
    c.width = 0; c.height = 0;
  }
  drawGrain();

  if (!REDUCED) {
    const box = $("#embers"), count = innerWidth < 768 ? 12 : 24;
    for (let i = 0; i < count; i++) {
      const p = document.createElement("div"), s = 1 + Math.random() * 2.5;
      p.className = "ember";
      p.style.cssText = `left:${Math.random() * 100}%;width:${s}px;height:${s}px;--drift:${(Math.random() - .5) * 120}px;animation-duration:${12 + Math.random() * 16}s;animation-delay:${Math.random() * 14}s`;
      box.appendChild(p);
    }
  }

  // Count-up (numbers are already in the HTML for crawlers; this only animates)
  if (!REDUCED) {
    $$("[data-count]").forEach((el) => {
      const end = parseFloat(el.dataset.count), t0 = performance.now() + 400, dur = 1600;
      el.textContent = "0";
      const step = (now) => {
        const p = Math.max(0, Math.min(1, (now - t0) / dur)), eased = 1 - Math.pow(1 - p, 4);
        el.textContent = Math.round(end * eased);
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    });
  }

  // Gallery
  $("#gallery-grid").innerHTML = GALLERY.map((it, pos) => `
    <button class="gallery-item${BIG.has(pos) ? " big" : ""}${it.color ? " in-color" : ""}" data-pos="${pos}" aria-label="Ver tatuaje ${it.style} · ${it.name}">
      <img src="${it.src}" alt="Tatuaje ${it.style} ${it.name} en Bogotá" loading="lazy" />
      <div class="shade"></div><div class="frame"></div>
      <span class="zoom"><i class="fas fa-expand"></i></span>
      <div class="meta"><small>${it.style}</small><span>${it.name}</span></div>
    </button>`).join("");
  $("#gallery-grid").addEventListener("click", (e) => {
    const it = e.target.closest(".gallery-item");
    if (it) openLightbox(+it.dataset.pos);
  });

  // Lightbox
  const lb = $("#lightbox"), lbImg = $("#lb-img");
  let lbPos = 0, lastFocus = null;
  function updateLb(animate) {
    const it = GALLERY[lbPos];
    const apply = () => {
      lbImg.src = it.src; lbImg.alt = `Tatuaje ${it.style} · ${it.name}`;
      $("#lb-caption small").textContent = it.style;
      $("#lb-caption span").textContent = it.name;
      $("#lb-count").textContent = `${pad(lbPos + 1)} / ${pad(GALLERY.length)}`;
      lbImg.classList.remove("swap");
    };
    if (animate && !REDUCED) { lbImg.classList.add("swap"); setTimeout(apply, 180); } else apply();
  }
  function openLightbox(pos) {
    lastFocus = document.activeElement;
    lbPos = pos; updateLb(false);
    lb.classList.add("open"); document.body.style.overflow = "hidden";
    $("#lb-close").focus();
  }
  function closeLightbox() {
    lb.classList.remove("open"); document.body.style.overflow = "";
    if (lastFocus) lastFocus.focus();
  }
  const stepLb = (dir) => { lbPos = (lbPos + dir + GALLERY.length) % GALLERY.length; updateLb(true); };
  $("#lb-close").addEventListener("click", closeLightbox);
  $("#lb-prev").addEventListener("click", () => stepLb(-1));
  $("#lb-next").addEventListener("click", () => stepLb(1));
  $("#lb-ask").addEventListener("click", () => {
    const it = GALLERY[lbPos];
    waOpen(`Hola Julián! Vi tu tatuaje "${it.name}" y quiero un cover up parecido 🖤`);
  });
  lb.addEventListener("click", (e) => { if (e.target === e.currentTarget) closeLightbox(); });
  document.addEventListener("keydown", (e) => {
    if (!lb.classList.contains("open")) return;
    if (e.key === "ArrowLeft") stepLb(-1);
    if (e.key === "ArrowRight") stepLb(1);
    if (e.key === "Escape") closeLightbox();
  });
  let touchX = null;
  lb.addEventListener("touchstart", (e) => { touchX = e.touches[0].clientX; }, { passive: true });
  lb.addEventListener("touchend", (e) => {
    if (touchX === null) return;
    const dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 50) stepLb(dx < 0 ? 1 : -1);
    touchX = null;
  });

  // Scroll: active section, progress, hide-on-scroll nav
  const SECTIONS = ["hero", "que-es", "estilos", "galeria", "proceso", "precios", "cotizar", "faq", "relacionados", "ubicacion"];
  const nav = $("#desktop-nav"), progress = $("#progress"), navItems = $$("[data-section]");
  let lastY = 0, ticking = false;
  function onScroll() {
    const y = scrollY;
    let current = SECTIONS[0];
    for (const id of SECTIONS) {
      const el = document.getElementById(id);
      if (el && y + 200 >= el.offsetTop) current = id;
    }
    navItems.forEach((el) => el.classList.toggle("active", el.dataset.section === current));
    nav.classList.toggle("scrolled", y > 20);
    nav.classList.toggle("hide", y > 600 && y > lastY + 4);
    if (y < lastY - 4) nav.classList.remove("hide");
    lastY = y;
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    ticking = false;
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  // Reveal on scroll
  $$(".stagger").forEach((g) => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .1, rootMargin: "0px 0px -40px 0px" });
    $$(".reveal, .stagger").forEach((el) => io.observe(el));
  } else {
    $$(".reveal, .stagger").forEach((el) => el.classList.add("in"));
  }

  // Mouse-only effects
  if (FINE && !REDUCED) {
    const ring = $("#cursor"), dot = $("#cursor-dot");
    let mx = 0, my = 0, rx = 0, ry = 0;
    addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px, ${my}px)`;
      ring.classList.add("on"); dot.classList.add("on");
    });
    document.addEventListener("mouseleave", () => { ring.classList.remove("on"); dot.classList.remove("on"); });
    const follow = () => {
      rx += (mx - rx) * .18; ry += (my - ry) * .18;
      ring.style.transform = `translate(${rx}px, ${ry}px)`;
      requestAnimationFrame(follow);
    };
    follow();
    document.addEventListener("mouseover", (e) => {
      ring.classList.toggle("hover", !!e.target.closest("a, button, label, .gallery-item, summary, input, select, textarea"));
    });
    $$(".magnetic").forEach((b) => {
      b.addEventListener("mousemove", (e) => {
        const r = b.getBoundingClientRect();
        b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .25}px, ${(e.clientY - r.top - r.height / 2) * .35}px)`;
      });
      b.addEventListener("mouseleave", () => { b.style.transform = ""; });
    });
    const hv = $("#hero-visual");
    hv.addEventListener("mousemove", (e) => {
      const r = hv.getBoundingClientRect();
      const x = (e.clientX - r.left) / r.width - .5, y = (e.clientY - r.top) / r.height - .5;
      hv.style.transform = `perspective(1000px) rotateY(${x * 8}deg) rotateX(${-y * 8}deg)`;
    });
    hv.addEventListener("mouseleave", () => { hv.style.transform = ""; });
  }

  // Quote form -> WhatsApp
  $("#variante-chips").innerHTML = VARIANTES.map((v, i) =>
    `<label class="chip"><input type="radio" name="variante" value="${v}"${i === 0 ? " checked" : ""} /><span>${v}</span></label>`).join("");
  const desc = $("#descripcion");
  desc.addEventListener("input", () => { $("#char-count").textContent = `${desc.value.length} / 500`; });
  $("#form-cotizar").addEventListener("submit", (e) => {
    e.preventDefault();
    const variante = $('input[name="variante"]:checked').value;
    const tamano = $("#tamano").value;
    const paleta = $("#paleta").value;
    const ubicacion = $("#zona").value.trim();
    const descripcion = desc.value.trim();
    if (!ubicacion) { showToast("Indica la zona del cuerpo", "error"); $("#zona").focus(); return; }
    if (descripcion.length < 10) { showToast("Cuéntame un poco más de tu idea", "error"); desc.focus(); return; }
    waOpen(`Hola Julián! Quiero tapar un tatuaje (COVER UP) 🖤\n🩹 Qué tapar: ${variante}\n📏 Tamaño actual: ${tamano}\n🎨 Estilo nuevo: ${paleta}\n📍 Zona: ${ubicacion}\n💭 Idea: ${descripcion}\n📸 Ahora te envío la foto del tatuaje`);
    showToast("Abriendo WhatsApp... no olvides adjuntar la foto", "success");
    e.target.reset();
    $("#char-count").textContent = "0 / 500";
  });
})();
</script>
</body>
</html>
