  .hero-meta span { display: inline-flex; align-items: center; gap: 8px; padding: 8px 14px; border: 1px solid var(--line-strong); background: rgba(13,11,10,.6); font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--bone); }
  .hero-meta i { color: var(--frost); }
  .hero-btns { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 34px; }
  @media (max-width: 480px) { .hero-btns .btn { flex: 1 1 100%; } }

  .hero-visual { position: relative; width: 100%; max-width: 420px; margin: 0 auto 10px; animation: rise 1.2s .2s var(--ease) both; }
  @media (min-width: 1024px) { .hero-visual { max-width: 480px; margin: 0 0 0 auto; } }
  .arch { position: relative; width: 100%; aspect-ratio: 3 / 4; border-radius: 999px 999px 0 0; overflow: hidden; border: 1px solid var(--line-strong); background: var(--ink-3); animation: archOpen 1.6s var(--ease-io) both .3s; }
  .arch::after { content: ""; position: absolute; inset: 10px; border-radius: 999px 999px 0 0; border: 1px solid rgba(236,227,210,.22); pointer-events: none; }
  .arch img { width: 100%; height: 100%; object-fit: cover; object-position: 40% center; filter: contrast(1.08) brightness(.82); transition: transform 1.2s var(--ease), filter .8s; }
  .hero-visual:hover .arch img { transform: scale(1.04); filter: contrast(1.1) brightness(.95); }
  .arch-shade { position: absolute; inset: 0; background: linear-gradient(180deg, transparent 45%, rgba(7,6,6,.92)); }
  .thermo { position: absolute; left: 22px; right: 22px; bottom: 22px; z-index: 2; display: grid; grid-template-columns: repeat(3, 1fr); background: rgba(7,6,6,.82); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); border: 1px solid var(--line-strong); }
  .thermo div { padding: 14px 10px; text-align: center; }
  .thermo div + div { border-left: 1px solid var(--line); }
  .thermo b { display: block; font-family: var(--sans); font-weight: 300; font-size: 24px; color: var(--bone); line-height: 1; }
  .thermo b.c { color: var(--frost); }
  .thermo small { display: block; font-family: var(--sans); font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--ash); margin-top: 6px; }
  .stamp { position: absolute; top: 7%; right: -4%; z-index: 4; width: 122px; height: 122px; }
  @media (min-width: 1024px) { .stamp { width: 140px; height: 140px; right: -8%; } }
  .stamp svg { width: 100%; height: 100%; animation: spin 26s linear infinite; }
  .stamp text { font-family: var(--sans); font-size: 10.5px; letter-spacing: 3.2px; text-transform: uppercase; fill: var(--bone); }
  .stamp .core { position: absolute; inset: 28%; border-radius: 50%; background: var(--blood); display: flex; align-items: center; justify-content: center; box-shadow: 0 0 30px var(--blood-glow); color: var(--bone); font-size: 22px; }

  /* ---------- Marquee ---------- */
  .marquee { position: relative; z-index: 2; overflow: hidden; background: var(--blood); transform: rotate(-1.6deg); margin: 10px -20px; border-top: 1px solid var(--blood-hot); border-bottom: 1px solid var(--blood-hot); box-shadow: 0 20px 50px rgba(0,0,0,.5); }
  .marquee-track { display: flex; width: max-content; animation: marquee 34s linear infinite; }
  .marquee-track span { display: inline-flex; align-items: center; gap: 28px; padding: 16px 14px; font-family: var(--sans); font-size: clamp(14px, 3.5vw, 18px); font-weight: 500; letter-spacing: .3em; text-transform: uppercase; color: var(--bone); white-space: nowrap; }
  .marquee-track span::after { content: "\25C6"; font-size: 12px; color: var(--ink); }

  /* ---------- Section heads ---------- */
  .sec-head { display: flex; flex-direction: column; gap: 16px; margin-bottom: 44px; padding-bottom: 28px; border-bottom: 1px solid var(--line); }
  @media (min-width: 1024px) { .sec-head { flex-direction: row; align-items: flex-end; justify-content: space-between; margin-bottom: 56px; } }
  .sec-title { font-family: var(--gothic); font-weight: 400; font-size: clamp(2.6rem, 9vw, 4.6rem); line-height: .95; color: var(--bone); margin-top: 14px; }
  .sec-sub { font-size: 19px; font-style: italic; color: var(--bone-dim); max-width: 28rem; }
  @media (min-width: 1024px) { .sec-sub { text-align: right; } }

  /* ---------- Artículo: índice + cuerpo ---------- */
  .article-layout { display: grid; gap: 40px; }
  @media (min-width: 1024px) { .article-layout { grid-template-columns: 260px 1fr; gap: 64px; align-items: start; } }
  .toc { border: 1px solid var(--line-strong); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); padding: 24px 22px; }
  @media (min-width: 1024px) { .toc { position: sticky; top: 96px; } }
  .toc .toc-title { font-family: var(--sans); font-weight: 500; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: var(--blood-hot); margin-bottom: 14px; }
  .toc ol { list-style: none; counter-reset: toc; display: grid; gap: 2px; }
  .toc li { counter-increment: toc; }
  .toc a { display: flex; gap: 12px; padding: 8px 0; text-decoration: none; font-size: 17px; color: var(--bone-dim); transition: color .2s, padding .3s var(--ease); }
  .toc a::before { content: counter(toc, decimal-leading-zero); font-family: var(--sans); font-size: 11px; letter-spacing: .1em; color: var(--ash); padding-top: 4px; }
  .toc a:hover, .toc a.active { color: var(--bone); padding-left: 6px; }
  .toc a.active::before { color: var(--blood-hot); }

  .prose { max-width: 46rem; }
  .prose > * + * { margin-top: 20px; }
  .prose p { font-size: 20px; line-height: 1.7; color: var(--bone-dim); }
  .prose p strong { color: var(--bone); font-weight: 600; }
  .prose h2 { font-family: var(--gothic); font-weight: 400; font-size: clamp(2.2rem, 7vw, 3.4rem); line-height: 1; color: var(--bone); margin-top: 64px; scroll-margin-top: 90px; }
  .prose h2:first-child { margin-top: 0; }
  .prose h3 { font-family: var(--sans); font-weight: 400; font-size: 15px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); margin-top: 36px; }
  .prose ul.check { list-style: none; display: grid; gap: 12px; }
  .prose ul.check li { position: relative; padding-left: 34px; font-size: 19px; line-height: 1.6; color: var(--bone-dim); }
  .prose ul.check li::before { content: "\f00c"; font-family: "Font Awesome 6 Free"; font-weight: 900; position: absolute; left: 0; top: 3px; font-size: 13px; width: 22px; height: 22px; display: flex; align-items: center; justify-content: center; border: 1px solid rgba(224,27,34,.5); color: var(--blood-hot); }
  .prose ul.check li b { color: var(--bone); font-weight: 600; }
  .lead { font-size: 23px !important; font-style: italic; color: var(--bone) !important; }
  .lead::first-letter { font-family: var(--gothic); font-style: normal; float: left; font-size: 4.4em; line-height: .8; padding: 6px 12px 0 0; color: var(--blood-hot); }

  .callout { position: relative; display: grid; grid-template-columns: auto 1fr; gap: 18px; padding: 24px 22px; border: 1px solid rgba(159,196,214,.35); background: linear-gradient(160deg, var(--frost-dim), var(--ink-2) 70%); }
  .callout i { font-size: 22px; color: var(--frost); padding-top: 4px; }
  .callout p { font-size: 18px !important; margin: 0 !important; }
  .callout b { display: block; font-family: var(--sans); font-weight: 400; font-size: 12px; letter-spacing: .26em; text-transform: uppercase; color: var(--bone); margin-bottom: 6px; }
  .callout.alert { border-color: rgba(224,27,34,.5); background: linear-gradient(160deg, rgba(161,15,21,.16), var(--ink-2) 70%); }
  .callout.alert i { color: var(--blood-hot); }

  /* Factores del clima */
  .factors { display: grid; gap: 12px; }
  @media (min-width: 640px) { .factors { grid-template-columns: 1fr 1fr; } }
  .factor { position: relative; padding: 24px 22px; border: 1px solid var(--line); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); transition: transform .5s var(--ease), border-color .4s; }
  .factor:hover { transform: translateY(-4px); border-color: rgba(159,196,214,.4); }
  .factor i { font-size: 20px; color: var(--frost); }
  .factor h3 { margin-top: 14px !important; }
  .factor p { font-size: 17px !important; line-height: 1.55 !important; margin-top: 8px; font-style: italic; }

  /* Línea de tiempo */
  .timeline { list-style: none; border-left: 1px solid var(--line-strong); margin-left: 10px; }
  .timeline > li { position: relative; padding: 0 0 36px 32px; }
  .timeline > li:last-child { padding-bottom: 0; }
  .timeline > li::before { content: ""; position: absolute; left: -6px; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--ink); border: 1px solid var(--blood-hot); box-shadow: 0 0 10px var(--blood-glow); }
  .timeline .when { font-family: var(--sans); font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: var(--blood-hot); }
  .timeline h3 { margin-top: 6px !important; font-size: 17px !important; }
  .timeline p { font-size: 18px !important; margin-top: 8px; }
  .timeline ul.check { margin-top: 14px; }

  /* Sí / No */
  .dodont { display: grid; gap: 12px; }
  @media (min-width: 768px) { .dodont { grid-template-columns: 1fr 1fr; gap: 14px; } }
  .dd { padding: 26px 22px; border: 1px solid var(--line-strong); background: var(--ink-2); }
  .dd h3 { display: flex; align-items: center; gap: 10px; margin: 0 0 16px !important; }
  .dd.yes h3 i { color: var(--wa); }
  .dd.no h3 i { color: var(--blood-hot); }
  .dd ul { list-style: none; display: grid; gap: 10px; }
  .dd li { font-size: 18px; line-height: 1.5; color: var(--bone-dim); padding-left: 18px; position: relative; }
  .dd li::before { content: ""; position: absolute; left: 0; top: 11px; width: 8px; height: 1px; background: var(--ash); }
  .dd.yes li::before { background: var(--wa); }
  .dd.no li::before { background: var(--blood-hot); }

  /* ---------- Calculadora de fase ---------- */
  .phase-tool { padding: 32px 24px; border: 1px solid rgba(224,27,34,.35); background: linear-gradient(160deg, rgba(161,15,21,.14), var(--ink-2) 60%); }
  @media (min-width: 768px) { .phase-tool { padding: 40px 36px; } }
  .phase-tool h3 { font-family: var(--gothic) !important; font-size: 36px !important; letter-spacing: 0 !important; text-transform: none !important; margin: 0 !important; line-height: 1; }
  .phase-tool > p { font-size: 17px !important; font-style: italic; margin-top: 8px; }
  .phase-form { display: grid; gap: 12px; margin-top: 22px; }
  @media (min-width: 560px) { .phase-form { grid-template-columns: 1fr auto; align-items: end; } }
  .phase-form label { display: block; font-family: var(--sans); font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--bone-dim); margin-bottom: 9px; }
  .phase-form input { width: 100%; padding: 14px 16px; background: rgba(0,0,0,.4); border: 1px solid var(--line-strong); border-radius: 0; color: var(--bone); font-family: var(--serif); font-size: 18px; color-scheme: dark; outline: none; transition: border-color .25s, box-shadow .25s; }
  .phase-form input:focus { border-color: var(--blood-hot); box-shadow: 0 0 0 3px rgba(224,27,34,.12); }
  .phase-out { display: none; margin-top: 24px; padding-top: 22px; border-top: 1px solid var(--line); animation: rise .5s var(--ease) both; }
  .phase-out.show { display: block; }
  .phase-bar { position: relative; height: 6px; background: rgba(236,227,210,.08); margin: 14px 0 8px; }
  .phase-bar span { position: absolute; left: 0; top: 0; bottom: 0; width: 0; background: linear-gradient(90deg, var(--blood), var(--blood-hot)); box-shadow: 0 0 10px var(--blood-glow); transition: width 1s var(--ease); }
  .phase-scale { display: flex; justify-content: space-between; font-family: var(--sans); font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--ash); }
  .phase-day { font-family: var(--sans); font-weight: 300; font-size: 48px; line-height: 1; color: var(--bone); }
  .phase-day small { font-size: 14px; letter-spacing: .2em; text-transform: uppercase; color: var(--ash); margin-left: 8px; }
  .phase-name { font-family: var(--sans); font-size: 13px; letter-spacing: .26em; text-transform: uppercase; color: var(--blood-hot); margin-top: 10px; }
  .phase-tips { list-style: none; display: grid; gap: 8px; margin-top: 14px; }
  .phase-tips li { font-size: 18px; color: var(--bone-dim); padding-left: 26px; position: relative; }
  .phase-tips li i { position: absolute; left: 0; top: 5px; font-size: 13px; color: var(--frost); }

  /* ---------- Enlaces relacionados ---------- */
  .related { display: grid; gap: 14px; }
  @media (min-width: 768px) { .related { grid-template-columns: 1fr 1fr; gap: 18px; } }
  .rel { position: relative; display: flex; flex-direction: column; justify-content: space-between; gap: 26px; min-height: 230px; padding: 30px 26px; border: 1px solid var(--line-strong); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); text-decoration: none; color: var(--bone); overflow: hidden; transition: border-color .4s, transform .5s var(--ease); }
  .rel:hover { border-color: rgba(224,27,34,.6); transform: translateY(-4px); }
  .rel.hot { border-color: rgba(224,27,34,.45); background: linear-gradient(160deg, rgba(161,15,21,.18), var(--ink-2) 65%); }
  .rel .ic { width: 52px; height: 52px; display: flex; align-items: center; justify-content: center; border: 1px solid var(--line-strong); color: var(--blood-hot); font-size: 20px; }
  .rel small { display: block; font-family: var(--sans); font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: var(--blood-hot); }
  .rel b { display: block; font-family: var(--gothic); font-weight: 400; font-size: clamp(30px, 6vw, 40px); line-height: 1; margin-top: 8px; }
  .rel span.d { display: block; font-size: 17px; font-style: italic; color: var(--bone-dim); margin-top: 8px; }
  .rel .go { position: absolute; right: 24px; top: 30px; width: 46px; height: 46px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--blood); border: 1px solid var(--blood-hot); transition: transform .4s var(--ease); }
  .rel:hover .go { transform: translateX(4px) rotate(-45deg); }

  /* ---------- Autor ---------- */
  .author { display: grid; grid-template-columns: auto 1fr; gap: 20px; align-items: center; padding: 26px 22px; border: 1px solid var(--line); background: var(--ink-2); max-width: 46rem; margin-top: 56px; }
  .author img { width: 72px; height: 72px; border-radius: 50%; object-fit: cover; border: 1px solid var(--line-strong); filter: grayscale(1) contrast(1.2); background: var(--ink-3); padding: 10px; }
  .author b { display: block; font-family: var(--sans); font-weight: 400; font-size: 13px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); }
  .author p { font-size: 17px; font-style: italic; color: var(--bone-dim); margin-top: 6px; }

  /* ---------- FAQ ---------- */
  .faq-list { border-top: 1px solid var(--line); max-width: 900px; margin: 0 auto; }
  .faq-list details { border-bottom: 1px solid var(--line); }
  .faq-list summary { display: flex; align-items: center; justify-content: space-between; gap: 18px; padding: 24px 0; cursor: pointer; list-style: none; font-family: var(--serif); font-size: 22px; font-weight: 600; color: var(--bone); transition: color .2s; }
  .faq-list summary::-webkit-details-marker { display: none; }
  .faq-list summary:hover { color: var(--blood-hot); }
  .faq-list summary .pm { position: relative; flex-shrink: 0; width: 32px; height: 32px; border: 1px solid var(--line-strong); border-radius: 50%; }
  .faq-list summary .pm::before, .faq-list summary .pm::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1px; margin: 0 0 0 -6px; background: var(--bone); transition: transform .4s var(--ease); }
  .faq-list summary .pm::after { transform: rotate(90deg); }
  .faq-list details[open] summary .pm { border-color: var(--blood-hot); background: var(--blood); }
  .faq-list details[open] summary .pm::after { transform: rotate(0); }
  .faq-list details p { padding: 0 48px 26px 0; font-size: 18px; font-style: italic; color: var(--bone-dim); line-height: 1.6; animation: rise .5s var(--ease) both; }

  /* ---------- Final CTA ---------- */
  .final-cta { position: relative; overflow: hidden; text-align: center; padding: 100px 20px; border-top: 1px solid var(--line); }
  @media (min-width: 1024px) { .final-cta { padding: 140px 48px; } }
  .final-cta::before { content: ""; position: absolute; inset: 0; background: radial-gradient(ellipse 60% 70% at 50% 100%, rgba(161,15,21,.28), transparent 70%); pointer-events: none; }
  .final-cta h2 { position: relative; font-family: var(--gothic); font-weight: 400; font-size: clamp(3rem, 11vw, 6.6rem); line-height: .9; }
  .final-cta h2 em { font-style: normal; color: var(--blood-hot); }
  .final-cta p { position: relative; max-width: 32rem; margin: 22px auto 34px; font-size: 20px; font-style: italic; color: var(--bone-dim); }
  .final-cta .hero-btns { position: relative; justify-content: center; }

  /* ---------- Footer ---------- */
  footer { position: relative; z-index: 2; border-top: 1px solid var(--line); background: linear-gradient(180deg, transparent, rgba(161,15,21,.06)); padding: 64px 20px 130px; }
  @media (min-width: 1024px) { footer { padding: 90px 48px 40px; } }
  .footer-grid { display: grid; gap: 40px; }
  @media (min-width: 768px) { .footer-grid { grid-template-columns: 1fr 1fr; gap: 48px; } }
  @media (min-width: 1100px) { .footer-grid { grid-template-columns: 1.3fr 1fr 1fr 1fr; gap: 48px; } }
  .footer-brand .logo-link img { height: 54px; }
  .footer-brand .logo-link .wordmark b { font-size: 34px; }
  .footer-brand p { margin-top: 18px; font-size: 18px; font-style: italic; color: var(--bone-dim); max-width: 22rem; }
  .footer-col .col-title { font-family: var(--sans); font-weight: 500; font-size: 11px; letter-spacing: .32em; text-transform: uppercase; color: var(--blood-hot); margin-bottom: 18px; }
  .footer-col ul { list-style: none; display: grid; gap: 10px; }
  .footer-col li, .footer-col a { font-size: 18px; color: var(--bone-dim); text-decoration: none; transition: color .2s, padding .3s var(--ease); }
  .footer-col a:hover { color: var(--bone); padding-left: 6px; }
  .footer-col a[aria-current="page"] { color: var(--blood-hot); }
  .social-links { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 24px; }
  .social-links a { width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; font-size: 17px; color: var(--bone-dim); border: 1px solid var(--line-strong); text-decoration: none; transition: all .25s; border-radius: 50%; }
  .social-links a:hover { color: var(--bone); background: var(--blood); border-color: var(--blood-hot); transform: translateY(-2px); }
  .footer-bottom { display: flex; flex-direction: column; gap: 10px; margin-top: 56px; padding-top: 24px; border-top: 1px solid var(--line); font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--ash); }
  @media (min-width: 768px) { .footer-bottom { flex-direction: row; justify-content: space-between; } }
  .to-top { background: none; border: 0; cursor: pointer; font-family: var(--sans); font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--bone-dim); display: inline-flex; gap: 8px; align-items: center; }
  .to-top:hover { color: var(--blood-hot); }
  .legal-links { display: flex; flex-wrap: wrap; gap: 18px; }
  .legal-links a { color: var(--bone-dim); text-decoration: none; transition: color .2s; }
  .legal-links a:hover, .legal-links a[aria-current="page"] { color: var(--blood-hot); }

  /* ---------- Toast ---------- */
  #toast-container { position: fixed; top: 20px; left: 16px; right: 16px; z-index: 9999; display: flex; flex-direction: column; align-items: center; gap: 8px; pointer-events: none; }
  @media (min-width: 1024px) { #toast-container { left: auto; right: 24px; top: 84px; align-items: flex-end; } }
  .toast { display: flex; align-items: center; gap: 12px; padding: 15px 20px; font-family: var(--sans); font-size: 13px; letter-spacing: .06em; pointer-events: auto; animation: rise .4s var(--ease) both; max-width: 360px; background: var(--ink-4); border: 1px solid var(--line-strong); border-left: 3px solid; box-shadow: 0 20px 40px rgba(0,0,0,.6); transition: opacity .3s; }
  .toast.success { border-left-color: var(--wa); color: var(--bone); }
  .toast.success i { color: var(--wa); }
  .toast.error { border-left-color: var(--blood-hot); color: #ff8a8d; }

  /* ---------- Reveal ---------- */
  .reveal { opacity: 0; transform: translateY(30px); transition: opacity 1s var(--ease), transform 1s var(--ease); }
  .reveal.in { opacity: 1; transform: none; }
  .stagger > * { opacity: 0; transform: translateY(24px); transition: opacity .9s var(--ease), transform .9s var(--ease); transition-delay: calc(var(--i, 0) * 80ms); }
  .stagger.in > * { opacity: 1; transform: none; }
  .no-js .reveal, .no-js .stagger > * { opacity: 1; transform: none; }
  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    *, *::before, *::after { animation: none !important; transition: none !important; }
    .reveal, .stagger > * { opacity: 1; transform: none; }
  }

  /* ---------- Comparativa: tarjetas de estilo ---------- */
  .style-cards { display: grid; gap: 12px; }
  @media (min-width: 768px) { .style-cards { grid-template-columns: repeat(3, 1fr); } }
  .style-card { position: relative; padding: 26px 22px 24px; border: 1px solid var(--line-strong); background: linear-gradient(180deg, var(--ink-3), var(--ink-2)); transition: transform .5s var(--ease), border-color .4s; }
  .style-card:hover { transform: translateY(-4px); border-color: rgba(224,27,34,.5); }
  .style-card .pct { font-family: var(--sans); font-weight: 300; font-size: 44px; line-height: 1; color: var(--bone); }
  .style-card .pct small { font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--ash); margin-left: 6px; }
  .style-card h3 { margin-top: 12px !important; color: var(--blood-hot) !important; }
  .style-card p { font-size: 17px !important; line-height: 1.55 !important; margin-top: 8px; font-style: italic; }
  .meter { height: 3px; background: rgba(236,227,210,.08); margin-top: 18px; }
  .meter span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--blood), var(--blood-hot)); box-shadow: 0 0 10px var(--blood-glow); transition: width 1.4s var(--ease); }
  .stagger.in .meter span { width: var(--w); }

  /* Ficha de cada estilo */
  .spec { display: grid; grid-template-columns: repeat(2, 1fr); border: 1px solid var(--line-strong); background: var(--ink-2); }
  @media (min-width: 640px) { .spec { grid-template-columns: repeat(4, 1fr); } }
  .spec div { padding: 16px 14px; border-bottom: 1px solid var(--line); }
  .spec div:nth-child(odd) { border-right: 1px solid var(--line); }
  @media (min-width: 640px) { .spec div { border-bottom: 0; border-right: 1px solid var(--line); } .spec div:last-child { border-right: 0; } }
  .spec small { display: block; font-family: var(--sans); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--ash); }
  .spec b { display: block; font-family: var(--sans); font-weight: 400; font-size: 15px; letter-spacing: .06em; color: var(--bone); margin-top: 6px; }
  .style-link { display: inline-flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--blood-hot); text-decoration: none; border-bottom: 1px solid rgba(224,27,34,.35); padding-bottom: 4px; transition: gap .3s var(--ease), border-color .2s; }
  .style-link:hover { gap: 16px; border-color: var(--blood-hot); }

  /* Tabla comparativa */
  .table-wrap { overflow-x: auto; border: 1px solid var(--line-strong); background: var(--ink-2); -webkit-overflow-scrolling: touch; }
  .cmp { width: 100%; min-width: 620px; border-collapse: collapse; }
  .cmp th, .cmp td { padding: 14px 16px; text-align: left; vertical-align: top; border-bottom: 1px solid var(--line); }
  .cmp thead th { font-family: var(--sans); font-weight: 500; font-size: 11px; letter-spacing: .26em; text-transform: uppercase; color: var(--blood-hot); background: var(--ink-3); }
  .cmp tbody th { font-family: var(--sans); font-weight: 400; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; color: var(--bone); white-space: nowrap; }
  .cmp td { font-size: 17px; line-height: 1.45; color: var(--bone-dim); }
  .cmp tbody tr:last-child th, .cmp tbody tr:last-child td { border-bottom: 0; }
  .cmp tbody tr { transition: background .2s; }
  .cmp tbody tr:hover { background: rgba(224,27,34,.06); }
  .dots { letter-spacing: 3px; color: var(--blood-hot); white-space: nowrap; }
  .dots i { color: rgba(236,227,210,.15); font-style: normal; }
  .scroll-hint { display: block; margin-top: 8px; font-family: var(--sans); font-size: 10px; letter-spacing: .22em; text-transform: uppercase; color: var(--ash); }
  @media (min-width: 768px) { .scroll-hint { display: none; } }

  /* ---------- Selector de estilo ---------- */
  .quiz { padding: 32px 24px; border: 1px solid rgba(224,27,34,.35); background: linear-gradient(160deg, rgba(161,15,21,.14), var(--ink-2) 60%); scroll-margin-top: 90px; }
  @media (min-width: 768px) { .quiz { padding: 40px 36px; } }
  .quiz > h3 { font-family: var(--gothic) !important; font-size: 36px !important; letter-spacing: 0 !important; text-transform: none !important; margin: 0 !important; line-height: 1; }
  .quiz > p { font-size: 17px !important; font-style: italic; margin-top: 8px; }
  .q { border: 0; margin-top: 24px; }
  .q legend { font-family: var(--sans); font-size: 12px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); margin-bottom: 12px; }
  .q legend span { color: var(--blood-hot); margin-right: 8px; }
  .opts { display: flex; flex-wrap: wrap; gap: 8px; }
  .opts label { position: relative; cursor: pointer; }
  .opts input { position: absolute; opacity: 0; pointer-events: none; }
  .opts span { display: inline-flex; align-items: center; gap: 8px; padding: 11px 16px; border: 1px solid var(--line-strong); background: rgba(0,0,0,.35); font-size: 17px; color: var(--bone-dim); transition: border-color .2s, background .2s, color .2s; }
  .opts label:hover span { border-color: rgba(224,27,34,.5); color: var(--bone); }
  .opts input:checked + span { border-color: var(--blood-hot); background: rgba(161,15,21,.35); color: var(--bone); }
  .opts input:focus-visible + span { outline: 1px solid var(--blood-hot); outline-offset: 3px; }
  .quiz .btn { margin-top: 26px; }
  .quiz-out { display: none; margin-top: 26px; padding-top: 22px; border-top: 1px solid var(--line); animation: rise .5s var(--ease) both; }
  .quiz-out.show { display: block; }
  .quiz-out .res-label { font-family: var(--sans); font-size: 11px; letter-spacing: .3em; text-transform: uppercase; color: var(--ash); }
  .quiz-out .res-name { font-family: var(--gothic); font-size: clamp(2.4rem, 8vw, 3.4rem); line-height: 1; color: var(--bone); margin-top: 8px; }
  .quiz-out .res-why { font-size: 18px; font-style: italic; color: var(--bone-dim); margin-top: 10px; }
  .res-bars { display: grid; gap: 10px; margin: 18px 0 22px; }
  .res-bar { display: grid; grid-template-columns: 110px 1fr 44px; gap: 12px; align-items: center; font-family: var(--sans); font-size: 11px; letter-spacing: .18em; text-transform: uppercase; color: var(--bone-dim); }
  .res-bar .track { height: 4px; background: rgba(236,227,210,.08); }
  .res-bar .track span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--blood), var(--blood-hot)); transition: width .9s var(--ease); }
  .res-bar b { font-weight: 400; color: var(--bone); text-align: right; }

  /* ---------- Expediente (visual del hero) ---------- */
  .doc { position: relative; padding: 96px 28px 30px; border: 1px solid var(--line-strong); border-radius: 999px 999px 0 0; background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(161,15,21,.22), transparent 70%), linear-gradient(180deg, var(--ink-3), var(--ink-2)); animation: archOpen 1.6s var(--ease-io) both .3s; }
  .doc::after { content: ""; position: absolute; inset: 10px; border-radius: 999px 999px 0 0; border: 1px solid rgba(236,227,210,.14); pointer-events: none; }
  .doc-seal { position: absolute; top: 26px; left: 50%; width: 56px; height: 56px; margin-left: -28px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: var(--blood); border: 1px solid var(--blood-hot); box-shadow: 0 0 30px var(--blood-glow); font-size: 20px; color: var(--bone); }
  .doc .doc-title { text-align: center; font-family: var(--gothic); font-weight: 400; font-size: 38px; line-height: 1; color: var(--bone); }
  .doc > p { text-align: center; font-family: var(--sans); font-size: 10px; letter-spacing: .3em; text-transform: uppercase; color: var(--ash); margin-top: 10px; }
  .doc dl { margin-top: 24px; border-top: 1px solid var(--line); }
  .doc dl div { display: flex; justify-content: space-between; gap: 14px; padding: 13px 0; border-bottom: 1px solid var(--line); }
  .doc dt { font-family: var(--sans); font-size: 10px; letter-spacing: .24em; text-transform: uppercase; color: var(--ash); padding-top: 3px; }
  .doc dd { font-family: var(--sans); font-size: 14px; letter-spacing: .04em; color: var(--bone); text-align: right; }
  .doc dd.hot { color: var(--blood-hot); }
  .doc-sign { margin-top: 22px; text-align: center; font-family: var(--gothic); font-size: 30px; color: var(--bone-dim); }
  .doc-sign small { display: block; font-family: var(--sans); font-size: 9px; letter-spacing: .32em; text-transform: uppercase; color: var(--ash); margin-top: 4px; }

  /* ---------- Formulario de solicitud ---------- */
  .req-fields { display: grid; gap: 14px; margin-top: 24px; }
  @media (min-width: 640px) { .req-fields { grid-template-columns: 1fr 1fr; } .req-fields .full { grid-column: 1 / -1; } }
  .field label { display: block; font-family: var(--sans); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--bone); margin-bottom: 10px; }
  .field label span { color: var(--blood-hot); margin-right: 8px; }
  .field label em { font-style: normal; color: var(--ash); letter-spacing: .14em; }
  .field input, .field textarea { width: 100%; padding: 14px 16px; background: rgba(0,0,0,.4); border: 1px solid var(--line-strong); border-radius: 0; color: var(--bone); font-family: var(--serif); font-size: 18px; outline: none; resize: vertical; transition: border-color .25s, box-shadow .25s; }
  .field textarea { min-height: 110px; }
  .field input::placeholder, .field textarea::placeholder { color: var(--ash); font-style: italic; }
  .field input:focus, .field textarea:focus { border-color: var(--blood-hot); box-shadow: 0 0 0 3px rgba(224,27,34,.12); }
  .req-preview { margin-top: 14px; padding: 20px 18px; border: 1px dashed var(--line-strong); background: rgba(0,0,0,.35); font-family: var(--serif); font-size: 17px; line-height: 1.6; color: var(--bone-dim); white-space: pre-wrap; word-break: break-word; }
  .req-note { display: flex; gap: 10px; margin-top: 14px; font-family: var(--sans); font-size: 11px; letter-spacing: .14em; text-transform: uppercase; color: var(--frost); }

  /* ---------- Acciones del documento ---------- */
  .doc-actions { display: flex; flex-wrap: wrap; gap: 10px; }
  .updated { display: inline-flex; align-items: center; gap: 10px; font-family: var(--sans); font-size: 11px; letter-spacing: .24em; text-transform: uppercase; color: var(--ash); }
  .updated i { color: var(--frost); }
  .legal { font-size: 15px !important; font-style: italic; color: var(--ash) !important; border-top: 1px solid var(--line); padding-top: 16px; }
  .cmp td b { color: var(--bone); font-weight: 600; }
  .tag-s { display: inline-block; margin-top: 6px; padding: 3px 8px; font-family: var(--sans); font-size: 9px; letter-spacing: .22em; text-transform: uppercase; color: var(--blood-hot); border: 1px solid rgba(224,27,34,.45); }

  /* ---------- Impresión ---------- */
  @media print {
    #cursor, #cursor-dot, #progress, #grain, #smoke, #vignette, #toast-container, #desktop-nav, #mobile-header, #mobile-nav, #wa-float, .marquee, .hero-visual, .hero-btns, .toc, #solicitud, .final-cta, .social-links, .to-top, .doc-actions { display: none !important; }
    body { background: #fff; color: #111; font-size: 12pt; }
    section { padding: 16px 0 !important; }
    .prose p, .prose li, .cmp td, .factor p, .timeline p, .faq-list details p, .callout p { color: #222 !important; }
    .prose h2, .hero-title, .sec-title, .prose h3, .factor h3, .cmp th, .faq-list summary { color: #000 !important; text-shadow: none !important; -webkit-text-stroke: 0 !important; }
    .hero-title .outline { color: #000 !important; }
    .reveal, .stagger > * { opacity: 1 !important; transform: none !important; }
    .factor, .callout, .table-wrap, .cmp thead th, .faq-list, footer { background: none !important; border-color: #ccc !important; }
    .faq-list details p { display: block; }
    a { color: #000 !important; }
  }

  /* =====================================================================
     ESTILO UNIFICADO CON LA PÁGINA PRINCIPAL (web + móvil)
     Oswald en etiquetas, títulos góticos con degradado plateado/carmesí,
     cuerpo de texto en Roboto y botones píldora carmesí brillante.
     ===================================================================== */
  body { font-family: var(--ref-sans); color: var(--ref-white); font-size: max(16px, min(18.5px, calc(0.94rem + 0.22vw))); line-height: 1.6; text-rendering: optimizeLegibility; }
  h1, h2, h3, .sec-title, .final-cta h2, .doc-title, .quiz > h3 { text-wrap: balance; }
  p, li, summary { text-wrap: pretty; }
  .txt-link { color: var(--blood-hot); border-bottom-color: rgba(217,0,22,.4); }
  .txt-link:hover { color: #fff; border-color: #fff; }
  #smoke { background:
      radial-gradient(ellipse 40% 30% at 20% 30%, rgba(255,255,255,.03), transparent 70%),
      radial-gradient(ellipse 50% 35% at 80% 75%, rgba(168,0,15,.12), transparent 70%); }

  /* ---------- Encabezado escritorio (igual a la principal) ---------- */
  .logo-link img { filter: grayscale(1) brightness(1.6) contrast(1.15); }
  .logo-link .wordmark b { color: var(--ref-white); }
  .logo-link .wordmark small { color: var(--ref-grey); letter-spacing: .38em; white-space: nowrap; }
  #desktop-nav { background: rgba(5,5,5,.72); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px); border-bottom-color: rgba(255,255,255,.05); }
  #desktop-nav.scrolled { background: rgba(5,5,5,.9); border-color: rgba(255,255,255,.05); box-shadow: 0 10px 40px -20px rgba(0,0,0,.9); }
  .nav-links { gap: 0; padding: 0 8px; height: 46px; border: 1px solid rgba(255,255,255,.16); background: linear-gradient(180deg, rgba(26,24,24,.82), rgba(8,8,8,.86)); box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 10px 30px -12px rgba(0,0,0,.9); }
  .nav-links a { padding: 0 13px; line-height: 46px; border-radius: 0; background: none !important; font-size: max(12.5px, calc(13 * var(--u))); font-weight: 400; letter-spacing: .08em; color: var(--ref-white); opacity: .9; white-space: nowrap; transition: color .3s, opacity .3s, text-shadow .3s; }
  .nav-links a::after { content: ""; position: absolute; left: 50%; bottom: 6px; width: 34px; height: 3px; margin-left: -17px; border-radius: 3px; background: var(--blood-hot); box-shadow: 0 0 8px 1px rgba(217,0,22,.95), 0 0 18px 3px rgba(217,0,22,.55); transform: scaleX(0); transition: transform .4s var(--ease); }
  .nav-links a:hover { opacity: 1; color: var(--ref-white); }
  .nav-links a:hover::after { transform: scaleX(.5); }
  .nav-links a.active { color: #ff2235; opacity: 1; text-shadow: 0 0 12px rgba(217,0,22,.65); }
  .nav-links a.active::after { transform: scaleX(1); }
  .nav-right .ig { display: inline-flex; align-items: center; justify-content: center; width: 44px; height: 44px; color: var(--ref-white); font-size: 21px; text-decoration: none; transition: color .3s, text-shadow .3s; }
  .nav-right .ig:hover { color: var(--blood-hot); text-shadow: 0 0 14px rgba(217,0,22,.6); }
  #desktop-nav .nav-cta { min-height: 42px; gap: 10px; padding: 0 18px; border-radius: 9px; background: linear-gradient(180deg, #f2142c 0%, #d10014 55%, #9e000e 100%); border: 1px solid rgba(255,120,130,.55); box-shadow: 0 8px 26px -8px rgba(217,0,22,.85), 0 0 22px -6px rgba(217,0,22,.7), inset 0 1px 0 rgba(255,255,255,.3); font-size: 13px; font-weight: 500; letter-spacing: .05em; color: #fff; white-space: nowrap; }
  #desktop-nav .nav-cta::before { background: linear-gradient(180deg, #ff2a40, #d90016); }
  #desktop-nav .nav-cta:hover { box-shadow: 0 12px 34px -8px rgba(217,0,22,.95), 0 0 0 4px rgba(217,0,22,.15), inset 0 1px 0 rgba(255,255,255,.3); }
  #desktop-nav .nav-cta i { font-size: .85em; }
  @media (min-width: 1024px) and (max-width: 1280px) { .nav-links a { padding: 0 9px; letter-spacing: .05em; } }

  /* ---------- Encabezado y menú móvil ---------- */
  #mobile-header { background: rgba(5,5,5,.9); border-bottom-color: rgba(255,255,255,.05); }
  .icon-btn { width: 44px; height: 44px; border: 2px solid rgba(255,255,255,.18); background: radial-gradient(circle at 35% 30%, #3ee77d, #1fb85a 70%); color: #fff; }
  #mobile-nav .nav-cta .disc { background: linear-gradient(180deg, #f2142c 0%, #d40016 48%, #93000d 100%); border-color: var(--ink); box-shadow: 0 8px 24px var(--blood-glow), inset 0 1px 0 rgba(255,255,255,.3); }
  @media (max-width: 767px) {
    #mobile-nav { height: 68px; padding: 0 6px; align-items: center; }
    #mobile-nav a, #mobile-nav button { height: 100%; justify-content: center; gap: 5px; font-size: 10.5px; letter-spacing: .04em; line-height: 1.2; padding: 0; }
    #mobile-nav a i, #mobile-nav button > i { font-size: 19px; line-height: 1; width: 22px; height: 20px; display: flex; align-items: center; justify-content: center; }
    #mobile-nav .nav-cta { position: relative; top: 0; justify-content: flex-end; padding-bottom: 13px; }
    #mobile-nav .nav-cta .disc { position: absolute; top: -24px; left: 50%; transform: translateX(-50%); }
  }

  /* WhatsApp flotante: disco verde sólido con punto vivo, como en la principal */
  #wa-float { width: max(56px, calc(74 * var(--u))); height: max(56px, calc(74 * var(--u))); right: calc(27 * var(--u)); bottom: calc(42 * var(--u)); background: radial-gradient(circle at 35% 30%, #3ee77d, #1fb85a 70%); border: 2px solid rgba(255,255,255,.18); color: #fff; font-size: max(26px, calc(36 * var(--u))); animation: pulseRingWa 2.4s infinite; }
  @keyframes pulseRingWa { 0% { box-shadow: 0 0 0 0 rgba(37,211,102,.45), 0 10px 30px -6px rgba(37,211,102,.55); } 100% { box-shadow: 0 0 0 16px rgba(37,211,102,0), 0 10px 30px -6px rgba(37,211,102,.55); } }
  #wa-float::after { content: ""; position: absolute; top: 4%; right: 4%; width: 18%; height: 18%; border-radius: 50%; background: #9dff6a; border: 2px solid #0b2a14; }

  /* ---------- Hero: mismo lenguaje que la principal ---------- */
  #hero { isolation: isolate; }
  #hero::before { content: ""; position: absolute; inset: 0; z-index: -1; pointer-events: none; background:
      radial-gradient(ellipse 14% 42% at 0% 52%, rgba(230,0,25,.45), transparent 72%),
      radial-gradient(ellipse 18% 40% at 100% 74%, rgba(230,0,25,.45), transparent 72%),
      radial-gradient(ellipse 40% 55% at 76% 46%, rgba(160,0,15,.12), transparent 70%); }
  .hero-sigil { border-color: rgba(255,255,255,.07); }
  .crumbs { gap: 14px; font-size: var(--t-label); font-weight: 400; letter-spacing: .1em; color: var(--ref-white); }
  .crumbs::before { content: ""; width: max(28px, calc(46 * var(--u))); height: 2px; background: var(--blood-hot); box-shadow: 0 0 8px rgba(217,0,22,.7); }
  .crumbs a { color: var(--ref-white); }
  .crumbs a:hover { color: var(--blood-hot); }
  .badge-ed { display: inline-flex; align-items: center; gap: 10px; min-height: 43px; padding: 0 18px; border: 1px solid rgba(255,255,255,.22); border-radius: var(--radius-pill); background: rgba(10,10,10,.62); font-family: var(--sans); font-size: var(--t-label); letter-spacing: .1em; text-transform: uppercase; color: var(--ref-white); }
  .badge-ed .dot { width: 4px; height: 4px; border-radius: 50%; background: var(--ref-white); }
  .badge-ed .dot.live { width: 9px; height: 9px; background: var(--blood-hot); box-shadow: 0 0 10px var(--blood-hot); animation: blink 1.8s ease-in-out infinite; }
  .badge-ed b { font-weight: 500; color: var(--ref-white); }

  .hero-title { font-family: var(--gothic); font-weight: 400; font-size: clamp(3.4rem, 14vw, calc(124 * var(--u))); line-height: 1.02; color: var(--ref-white); margin: 22px 0 22px; text-shadow: none; animation: none !important; }
  .hero-title .h1-kicker { font-family: var(--sans); font-size: var(--t-label); font-weight: 400; letter-spacing: .1em; line-height: 1.6; color: var(--ref-grey); margin-bottom: 16px; max-width: 34rem; }
  .hero-title .ln { display: block; white-space: nowrap; line-height: 1.02; }
  .hero-title .ln + .ln { margin-top: .04em; }
  .hero-title .ln > span { display: inline-block; padding: .14em .08em .1em; margin: -.14em -.08em -.1em; animation: inkIn 1.3s var(--ease) both; filter: drop-shadow(0 8px 24px rgba(0,0,0,.9)); }
  .hero-title .ln.blood > span { animation-delay: .25s; }
  .hero-title .ln.silver > span { background: linear-gradient(180deg, #ffffff 0%, #d9d9d9 45%, #8d8d8d 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .hero-title .ln.blood { font-size: 1.18em; }
  .hero-title .ln.blood > span { background: linear-gradient(180deg, #ff3346 0%, #e5001a 50%, #a1000f 100%); -webkit-background-clip: text; background-clip: text; color: transparent; filter: drop-shadow(0 0 22px rgba(217,0,22,.45)) drop-shadow(0 6px 18px rgba(0,0,0,.8)); }
  .hero-title .ul { display: block; width: min(64%, max(220px, calc(337 * var(--u)))); height: max(4px, calc(6 * var(--u))); margin-top: 14px; border-radius: 50%; background: linear-gradient(90deg, rgba(217,0,22,0) 0%, #e3001a 12%, #ff4a5a 45%, #e3001a 80%, rgba(217,0,22,0) 100%); box-shadow: 0 0 14px rgba(217,0,22,.6); transform-origin: 0 50%; animation: drawLineX 1s var(--ease) both .7s; }
  @keyframes drawLineX { from { transform: scaleX(0); } to { transform: scaleX(1); } }

  .hero-desc { font-family: var(--ref-sans); font-style: normal; font-weight: 400; font-size: max(16px, calc(19 * var(--u))); line-height: 1.55; color: #dedbd7; max-width: 34rem; }
  .hero-desc b { color: #fff; font-weight: 700; }
  .hero-meta span { min-height: 40px; padding: 0 16px; border-radius: var(--radius-pill); border-color: rgba(255,255,255,.22); background: rgba(10,10,10,.62); font-size: 12px; letter-spacing: .1em; color: var(--ref-white); }
  .hero-meta i, .updated i { color: var(--blood-hot); }

  /* Ficha del responsable */
  .doc { background: radial-gradient(ellipse 80% 50% at 50% 0%, rgba(217,0,22,.22), transparent 70%), linear-gradient(180deg, var(--ink-3), var(--ink-2)); }
  .doc-seal { background: radial-gradient(circle at 40% 35%, #ff2338, #c50014 70%); border-color: rgba(255,120,130,.6); }
  .doc dt { font-size: 11px; letter-spacing: .12em; color: var(--ref-grey); }
  .doc dd { font-family: var(--ref-sans); font-size: 14.5px; letter-spacing: 0; color: #fff; }
  .doc > p, .doc-sign small { font-size: 11px; letter-spacing: .16em; color: var(--ref-grey); }

  /* Franja */
  .marquee { background: linear-gradient(180deg, #e5001a, #a1000f); border-color: #ff2a40; }

