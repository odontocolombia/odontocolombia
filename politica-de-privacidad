  // Generador de solicitudes Habeas Data (todo ocurre en el navegador, nada se envía ni guarda)
  const REQ = {
    conocer: { kind: "consulta", subject: "Consulta de datos personales", body: "solicito conocer qué datos personales míos tiene Guerr Tattoo Studio y para qué finalidades los utiliza." },
    actualizar: { kind: "reclamo", subject: "Actualización de datos personales", body: "solicito actualizar o rectificar mis datos personales." },
    suprimir: { kind: "reclamo", subject: "Supresión de datos personales", body: "solicito la eliminación de mis datos personales de sus bases de datos, salvo aquellos que deban conservarse por obligación legal." },
    revocar: { kind: "reclamo", subject: "Revocatoria de autorización", body: "revoco la autorización que otorgué para el tratamiento de mis datos personales." },
    fotos: { kind: "reclamo", subject: "Retiro de fotografías", body: "solicito retirar de redes sociales, portafolio y sitio web las fotografías o videos en los que aparezco o aparece mi tatuaje." },
    promos: { kind: "reclamo", subject: "No recibir promociones", body: "solicito dejar de recibir mensajes promocionales y publicitarios. Pueden seguir contactándome solo para temas de mis citas." },
  };
  let lastText = "";
  $("#req-form").addEventListener("submit", (e) => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const type = fd.get("type");
    const name = String(fd.get("name") || "").trim();
    const contact = String(fd.get("contact") || "").trim();
    const detail = String(fd.get("detail") || "").trim();
    if (!type) { showToast("Elige qué necesitas", "error"); return; }
    if (name.length < 3) { showToast("Escribe tu nombre completo", "error"); return; }
    if (contact.length < 7) { showToast("Escribe un celular o correo de contacto", "error"); return; }
    const r = REQ[type];
    const date = new Date().toLocaleDateString("es-CO", { day: "numeric", month: "long", year: "numeric" });
    lastText = [
      `Bogotá, ${date}`,
      "",
      "Señores Guerr Tattoo Studio:",
      "",
      `Yo, ${name}, en ejercicio de mis derechos como titular según la Ley 1581 de 2012, ${r.body}`,
      ...(detail ? ["", `Detalle: ${detail}`] : []),
      "",
      `Contacto para la respuesta: ${contact}`,
      "",
      "Gracias,",
      name,
    ].join("\n");
    $("#req-preview").textContent = lastText;
    $("#req-term").textContent = r.kind === "consulta"
      ? "Es una consulta: respuesta en máximo 10 días hábiles"
      : "Es un reclamo: respuesta en máximo 15 días hábiles";
    $("#req-mail").href = `mailto:${EMAIL}?subject=${encodeURIComponent(`Habeas Data: ${r.subject}`)}&body=${encodeURIComponent(lastText)}`;
    $("#req-wa").href = WA + encodeURIComponent(lastText);
    $("#req-out").classList.add("show");
  });
  $("#req-copy").addEventListener("click", () => { if (lastText) copyText(lastText, "Solicitud copiada"); });

  // Scroll: sección activa, barra de progreso, nav que se oculta
  const SECTIONS = ["hero", "responsable", "datos", "finalidades", "autorizacion", "derechos", "procedimiento", "solicitud", "terceros", "cookies", "vigencia", "faq"];
  const NAV_GROUP = { datos: "responsable", autorizacion: "finalidades", procedimiento: "derechos", terceros: "solicitud", cookies: "solicitud", vigencia: "solicitud" };
  const nav = $("#desktop-nav"), progress = $("#progress"), navItems = $$("[data-section]"), tocLinks = $$(".toc a");
  let lastY = 0, ticking = false;
  function onScroll() {
    const y = scrollY;
    let current = SECTIONS[0];
    for (const id of SECTIONS) { const el = document.getElementById(id); if (el && y + 200 >= el.getBoundingClientRect().top + y) current = id; }
    const group = NAV_GROUP[current] || current;
    navItems.forEach((el) => el.classList.toggle("active", el.dataset.section === group));
    tocLinks.forEach((el) => el.classList.toggle("active", el.dataset.goto === current));
    nav.classList.toggle("scrolled", y > 20);
    nav.classList.toggle("hide", y > 600 && y > lastY + 4);
    if (y < lastY - 4) nav.classList.remove("hide");
    lastY = y;
    const max = document.documentElement.scrollHeight - innerHeight;
    progress.style.transform = `scaleX(${max > 0 ? y / max : 0})`;
    ticking = false;
  }
  addEventListener("scroll", () => { if (!ticking) { ticking = true; requestAnimationFrame(onScroll); } }, { passive: true });
  onScroll();

  // Reveal on scroll
  $$(".stagger").forEach((g) => [...g.children].forEach((c, i) => c.style.setProperty("--i", i)));
  if ("IntersectionObserver" in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((en) => { if (en.isIntersecting) { en.target.classList.add("in"); io.unobserve(en.target); } });
    }, { threshold: .1, rootMargin: "0px 0px -40px 0px" });
    $$(".reveal, .stagger").forEach((el) => io.observe(el));
  } else {
    $$(".reveal, .stagger").forEach((el) => el.classList.add("in"));
  }
  // Al imprimir, mostrar todo y abrir las respuestas
  addEventListener("beforeprint", () => {
    $$(".reveal, .stagger").forEach((el) => el.classList.add("in"));
    $$(".faq-list details").forEach((d) => { d.open = true; });
  });

  // Efectos solo con mouse
  if (FINE && !REDUCED) {
    const ring = $("#cursor"), dot = $("#cursor-dot");
    let mx = 0, my = 0, rx = 0, ry = 0;
    addEventListener("mousemove", (e) => {
      mx = e.clientX; my = e.clientY;
      dot.style.transform = `translate(${mx}px, ${my}px)`;
      ring.classList.add("on"); dot.classList.add("on");
    });
    document.addEventListener("mouseleave", () => { ring.classList.remove("on"); dot.classList.remove("on"); });
    const follow = () => { rx += (mx - rx) * .18; ry += (my - ry) * .18; ring.style.transform = `translate(${rx}px, ${ry}px)`; requestAnimationFrame(follow); };
    follow();
    document.addEventListener("mouseover", (e) => {
      ring.classList.toggle("hover", !!e.target.closest("a, button, label, summary, input, textarea"));
    });
    $$(".magnetic").forEach((b) => {
      b.addEventListener("mousemove", (e) => {
        const r = b.getBoundingClientRect();
        b.style.transform = `translate(${(e.clientX - r.left - r.width / 2) * .25}px, ${(e.clientY - r.top - r.height / 2) * .35}px)`;
      });
      b.addEventListener("mouseleave", () => { b.style.transform = ""; });
    });
  }
})();
</script>
</body>
</html>
